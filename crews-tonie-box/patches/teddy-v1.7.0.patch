diff --git a/TonieAudio/AudioInput.cs b/TonieAudio/AudioInput.cs
new file mode 100644
index 0000000..f59b1d8
--- /dev/null
+++ b/TonieAudio/AudioInput.cs
@@ -0,0 +1,589 @@
+﻿using Concentus.Oggfile;
+using Id3;
+using NAudio.Wave;
+using NAudio.Wave.SampleProviders;
+using NLayer.NAudioSupport;
+using NVorbis;
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using System.Runtime.InteropServices;
+using System.Text;
+
+namespace TonieFile
+{
+    /* an audio file opened for encoding, delivered as 16 bit PCM, 48 kHz stereo */
+    public class AudioSource : IDisposable
+    {
+        public IWaveProvider Pcm { get; internal set; }
+        internal WaveStream Stream;
+        internal string TempFile;
+
+        public double Progress => Stream == null || Stream.Length <= 0 ? 0 : Math.Min(1.0, (double)Stream.Position / Stream.Length);
+
+        public void Dispose()
+        {
+            Stream?.Dispose();
+            if (TempFile != null)
+            {
+                try
+                {
+                    File.Delete(TempFile);
+                }
+                catch (Exception)
+                {
+                }
+            }
+        }
+    }
+
+    public class AudioInfo
+    {
+        public string File;
+        public string Title;
+        public string Artist;
+        public string Album;
+        public int Track;
+        public double Seconds;
+    }
+
+    public static class AudioInput
+    {
+        /* decoded in managed code everywhere */
+        private static readonly string[] ManagedExtensions = { ".mp3", ".ogg", ".oga", ".opus", ".wav", ".wave", ".aif", ".aiff", ".aifc" };
+        /* decoded by macOS (afconvert) or ffmpeg */
+        private static readonly string[] SystemExtensions = { ".m4a", ".m4b", ".mp4", ".aac", ".alac", ".caf", ".flac", ".wma", ".webm", ".mka" };
+
+        private const int SampleRate = 48000;
+        /* Speex quality 5: 80 taps, ~100 dB stopband, passband up to 20 kHz for 44.1 kHz sources */
+        private const int ResamplerQuality = 5;
+
+        /* the ACM MP3 codec and MediaFoundationResampler only exist on Windows, use managed code elsewhere */
+        private static bool UseWindowsCodecs => RuntimeInformation.IsOSPlatform(OSPlatform.Windows);
+
+        private static bool IsMac => RuntimeInformation.IsOSPlatform(OSPlatform.OSX);
+
+        public static string[] Extensions => ManagedExtensions.Concat(SystemExtensions).ToArray();
+
+        public static bool IsSupported(string fileName)
+        {
+            string name = Path.GetFileName(fileName);
+            /* skip the "._name.mp3" AppleDouble files macOS leaves on FAT/exFAT drives */
+            return !name.StartsWith("._") && Extensions.Contains(Path.GetExtension(name).ToLowerInvariant());
+        }
+
+        public static AudioSource Open(string fileName)
+        {
+            var source = new AudioSource();
+            try
+            {
+                source.Stream = Standard(OpenStream(fileName, out source.TempFile));
+                source.Pcm = ConvertFormat(source.Stream);
+                return source;
+            }
+            catch (Exception)
+            {
+                source.Dispose();
+                throw;
+            }
+        }
+
+        private static WaveStream OpenStream(string fileName, out string tempFile)
+        {
+            tempFile = null;
+            switch (Path.GetExtension(fileName).ToLowerInvariant())
+            {
+                case ".mp3":
+                    return OpenMp3(fileName);
+
+                case ".ogg":
+                case ".oga":
+                case ".opus":
+                    switch (OggCodec(fileName))
+                    {
+                        case "opus":
+                            return new OpusWaveStream(File.Open(fileName, FileMode.Open, FileAccess.Read, FileShare.ReadWrite), SampleRate, 2);
+                        case "vorbis":
+                            return new VorbisWaveStream(fileName);
+                    }
+                    break;
+
+                case ".wav":
+                case ".wave":
+                    try
+                    {
+                        return new WaveFileReader(fileName);
+                    }
+                    catch (Exception) when (CanConvert())
+                    {
+                        /* compressed WAV, e.g. ADPCM */
+                    }
+                    break;
+
+                case ".aif":
+                case ".aiff":
+                case ".aifc":
+                    try
+                    {
+                        return new AiffFileReader(fileName);
+                    }
+                    catch (Exception) when (CanConvert())
+                    {
+                        /* compressed AIFF-C */
+                    }
+                    break;
+            }
+
+            tempFile = ConvertToWav(fileName);
+            return new WaveFileReader(tempFile);
+        }
+
+        private static WaveStream OpenMp3(string fileName)
+        {
+            if (UseWindowsCodecs)
+            {
+                /* same as NAudio's Mp3FileReader */
+                return new Mp3FileReaderBase(fileName, format => new AcmMp3FrameDecompressor(format));
+            }
+            return new Mp3FileReaderBase(fileName, format => new Mp3FrameDecompressor(format));
+        }
+
+        /* "opus", "vorbis" or null, from the first packet of an Ogg file */
+        private static string OggCodec(string fileName)
+        {
+            byte[] head = new byte[64];
+            using (var file = File.Open(fileName, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
+            {
+                file.Read(head, 0, head.Length);
+            }
+            string text = Encoding.ASCII.GetString(head);
+            if (!text.StartsWith("OggS"))
+            {
+                return null;
+            }
+            if (text.Contains("OpusHead"))
+            {
+                return "opus";
+            }
+            if (text.Contains("vorbis"))
+            {
+                return "vorbis";
+            }
+            return null;
+        }
+
+        /* WAVE_FORMAT_EXTENSIBLE, which ffmpeg, macOS and many recorders write for 24 bit and float audio,
+           as the plain PCM or float format NAudio can convert */
+        private static WaveStream Standard(WaveStream stream)
+        {
+            var format = stream.WaveFormat;
+            if (format.Encoding != WaveFormatEncoding.Extensible)
+            {
+                return stream;
+            }
+            ushort subFormat = 0;
+            if (format is WaveFormatExtensible extensible)
+            {
+                subFormat = BitConverter.ToUInt16(extensible.SubFormat.ToByteArray(), 0);
+            }
+            else if (format is WaveFormatExtraData extra && extra.ExtraSize >= 22)
+            {
+                /* cbSize 22: valid bits (2), channel mask (4), sub format GUID (16) starting with the format code */
+                subFormat = BitConverter.ToUInt16(extra.ExtraData, 6);
+            }
+            switch (subFormat)
+            {
+                case 1:
+                    return new FormatOverride(stream, new WaveFormat(format.SampleRate, format.BitsPerSample, format.Channels));
+                case 3:
+                    return new FormatOverride(stream, WaveFormat.CreateIeeeFloatWaveFormat(format.SampleRate, format.Channels));
+                default:
+                    return stream;
+            }
+        }
+
+        private class FormatOverride : WaveStream
+        {
+            private readonly WaveStream source;
+            private readonly WaveFormat format;
+
+            public FormatOverride(WaveStream source, WaveFormat format)
+            {
+                this.source = source;
+                this.format = format;
+            }
+
+            public override WaveFormat WaveFormat => format;
+            public override long Length => source.Length;
+
+            public override long Position
+            {
+                get => source.Position;
+                set => source.Position = value;
+            }
+
+            public override int Read(byte[] buffer, int offset, int count) => source.Read(buffer, offset, count);
+
+            protected override void Dispose(bool disposing)
+            {
+                if (disposing)
+                {
+                    source.Dispose();
+                }
+                base.Dispose(disposing);
+            }
+        }
+
+        /* returns the stream's audio as 16 bit PCM in 48 kHz stereo */
+        internal static IWaveProvider ConvertFormat(WaveStream stream)
+        {
+            var outFormat = new WaveFormat(SampleRate, 2);
+
+            if (UseWindowsCodecs)
+            {
+                return new MediaFoundationResampler(stream, outFormat);
+            }
+
+            ISampleProvider samples = stream.ToSampleProvider();
+
+            if (samples.WaveFormat.Channels == 1)
+            {
+                samples = new MonoToStereoSampleProvider(samples);
+            }
+            else if (samples.WaveFormat.Channels > 2)
+            {
+                samples = new StereoDownmix(samples);
+            }
+
+            IWaveProvider pcm = new SampleToWaveProvider16(samples);
+
+            if (pcm.WaveFormat.SampleRate != SampleRate)
+            {
+                pcm = new SpeexResamplingWaveProvider(pcm, SampleRate, ResamplerQuality);
+            }
+
+            return new FullReadWaveProvider(pcm);
+        }
+
+        public static bool CanConvert()
+        {
+            return ConverterTool() != null;
+        }
+
+        private static string ConverterTool()
+        {
+            if (IsMac && File.Exists("/usr/bin/afconvert"))
+            {
+                return "/usr/bin/afconvert";
+            }
+            return FindInPath("ffmpeg");
+        }
+
+        private static string FindInPath(string tool)
+        {
+            string path = Environment.GetEnvironmentVariable("PATH") ?? "";
+            foreach (string dir in path.Split(Path.PathSeparator).Concat(new[] { "/opt/homebrew/bin", "/usr/local/bin" }))
+            {
+                string candidate = Path.Combine(dir, tool + (UseWindowsCodecs ? ".exe" : ""));
+                if (!string.IsNullOrEmpty(dir) && File.Exists(candidate))
+                {
+                    return candidate;
+                }
+            }
+            return null;
+        }
+
+        /* decodes formats like AAC/M4A, ALAC or FLAC with macOS' own decoders (or ffmpeg) into a temporary WAV file */
+        private static string ConvertToWav(string fileName)
+        {
+            string tool = ConverterTool();
+            if (tool == null)
+            {
+                throw new InvalidDataException("'" + Path.GetFileName(fileName) + "' is in a format that needs ffmpeg on this system");
+            }
+
+            string wav = Path.Combine(Path.GetTempPath(), "tonie-" + Guid.NewGuid().ToString("N") + ".wav");
+            string[] arguments = tool.EndsWith("afconvert")
+                ? new[] { "-f", "WAVE", "-d", "LEF32", fileName, wav }
+                : new[] { "-v", "error", "-nostdin", "-y", "-i", fileName, "-vn", "-c:a", "pcm_f32le", "-f", "wav", wav };
+
+            if (!Run(tool, arguments, out string output) || !File.Exists(wav))
+            {
+                try
+                {
+                    File.Delete(wav);
+                }
+                catch (Exception)
+                {
+                }
+                throw new InvalidDataException("Could not read '" + Path.GetFileName(fileName) + "': " + output.Trim());
+            }
+            return wav;
+        }
+
+        internal static bool Run(string tool, string[] arguments, out string output)
+        {
+            var info = new ProcessStartInfo(tool, string.Join(" ", arguments.Select(Quote)))
+            {
+                UseShellExecute = false,
+                RedirectStandardOutput = true,
+                RedirectStandardError = true,
+                CreateNoWindow = true
+            };
+            using (var process = Process.Start(info))
+            {
+                var stderr = process.StandardError.ReadToEndAsync();
+                string stdout = process.StandardOutput.ReadToEnd();
+                process.WaitForExit();
+                output = stdout + stderr.Result;
+                return process.ExitCode == 0;
+            }
+        }
+
+        private static string Quote(string argument)
+        {
+            return "\"" + argument.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
+        }
+
+        /* title, track number and duration for showing a file before it is encoded */
+        public static AudioInfo Probe(string fileName)
+        {
+            var info = new AudioInfo { File = fileName, Title = CleanName(fileName) };
+            string ext = Path.GetExtension(fileName).ToLowerInvariant();
+
+            try
+            {
+                if (ext == ".mp3")
+                {
+                    using (var mp3 = new Mp3(fileName, Mp3Permissions.Read))
+                    {
+                        var tag = mp3.GetAllTags().FirstOrDefault();
+                        if (tag != null)
+                        {
+                            if (tag.Title.IsAssigned && !string.IsNullOrWhiteSpace(tag.Title.Value))
+                            {
+                                info.Title = tag.Title.Value.Trim();
+                            }
+                            if (tag.Artists.IsAssigned)
+                            {
+                                info.Artist = tag.Artists.Value.FirstOrDefault();
+                            }
+                            if (tag.Album.IsAssigned)
+                            {
+                                info.Album = tag.Album.Value;
+                            }
+                            if (tag.Track.IsAssigned)
+                            {
+                                info.Track = tag.Track.Value;
+                            }
+                        }
+                    }
+                }
+            }
+            catch (Exception)
+            {
+                /* broken tags do not matter here */
+            }
+
+            try
+            {
+                if (ext == ".mp3" || ext == ".wav" || ext == ".wave" || ext == ".aif" || ext == ".aiff" || ext == ".aifc" || OggCodec(fileName) != null)
+                {
+                    using (var stream = OpenStream(fileName, out string temp))
+                    {
+                        /* OpusWaveStream counts its length in ticks */
+                        info.Seconds = stream is OpusWaveStream opus ? opus.OpusDecoder.TotalTime.TotalSeconds : stream.TotalTime.TotalSeconds;
+                        if (stream is VorbisWaveStream vorbis)
+                        {
+                            info.Title = vorbis.Title ?? info.Title;
+                            info.Artist = vorbis.Artist;
+                        }
+                    }
+                }
+                else if (IsMac && File.Exists("/usr/bin/afinfo") && Run("/usr/bin/afinfo", new[] { fileName }, out string output))
+                {
+                    foreach (string line in output.Split('\n'))
+                    {
+                        string text = line.Trim();
+                        if (text.StartsWith("estimated duration:") && double.TryParse(text.Split(' ')[2], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double seconds))
+                        {
+                            info.Seconds = seconds;
+                        }
+                        else if (text.StartsWith("title:"))
+                        {
+                            info.Title = text.Substring(6).Trim();
+                        }
+                        else if (text.StartsWith("artist:"))
+                        {
+                            info.Artist = text.Substring(7).Trim();
+                        }
+                    }
+                }
+                else if (FindInPath("ffprobe") is string ffprobe && Run(ffprobe, new[] { "-v", "error", "-show_entries", "format=duration:format_tags=title,artist,track", "-of", "default=noprint_wrappers=1", fileName }, out string probe))
+                {
+                    foreach (string line in probe.Split('\n'))
+                    {
+                        string[] kv = line.Trim().Split(new[] { '=' }, 2);
+                        if (kv.Length < 2)
+                        {
+                            continue;
+                        }
+                        switch (kv[0].ToLowerInvariant())
+                        {
+                            case "duration":
+                                double.TryParse(kv[1], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out info.Seconds);
+                                break;
+                            case "tag:title":
+                                info.Title = kv[1];
+                                break;
+                            case "tag:artist":
+                                info.Artist = kv[1];
+                                break;
+                            case "tag:track":
+                                int.TryParse(kv[1].Split('/')[0], out info.Track);
+                                break;
+                        }
+                    }
+                }
+            }
+            catch (Exception)
+            {
+                info.Seconds = 0;
+            }
+            return info;
+        }
+
+        /* "03 - The Big Bear.mp3" -> "The Big Bear" */
+        public static string CleanName(string fileName)
+        {
+            string name = Path.GetFileNameWithoutExtension(fileName).Replace('_', ' ').Trim();
+            string stripped = System.Text.RegularExpressions.Regex.Replace(name, @"^(track\s*)?\d{1,3}\s*[-._)\]]*\s*", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();
+            return stripped.Length > 0 ? stripped : name;
+        }
+
+        /* ConvertToFloat() and the encoder loop expect full buffers except at the end of the stream */
+        private class FullReadWaveProvider : IWaveProvider
+        {
+            private readonly IWaveProvider Source;
+
+            public FullReadWaveProvider(IWaveProvider source)
+            {
+                Source = source;
+            }
+
+            public WaveFormat WaveFormat => Source.WaveFormat;
+
+            public int Read(byte[] buffer, int offset, int count)
+            {
+                int total = 0;
+
+                while (total < count)
+                {
+                    int read = Source.Read(buffer, offset + total, count - total);
+
+                    if (read <= 0)
+                    {
+                        break;
+                    }
+                    total += read;
+                }
+                return total;
+            }
+        }
+
+        /* folds any number of channels into stereo: even channels left, odd channels right */
+        private class StereoDownmix : ISampleProvider
+        {
+            private readonly ISampleProvider Source;
+            private readonly int Channels;
+            private float[] Buffer = new float[0];
+
+            public WaveFormat WaveFormat { get; }
+
+            public StereoDownmix(ISampleProvider source)
+            {
+                Source = source;
+                Channels = source.WaveFormat.Channels;
+                WaveFormat = WaveFormat.CreateIeeeFloatWaveFormat(source.WaveFormat.SampleRate, 2);
+            }
+
+            public int Read(float[] buffer, int offset, int count)
+            {
+                int frames = count / 2;
+                if (Buffer.Length < frames * Channels)
+                {
+                    Buffer = new float[frames * Channels];
+                }
+                int read = Source.Read(Buffer, 0, frames * Channels) / Channels;
+                float scale = 2.0f / Channels;
+                for (int frame = 0; frame < read; frame++)
+                {
+                    float left = 0, right = 0;
+                    for (int ch = 0; ch < Channels; ch++)
+                    {
+                        if ((ch & 1) == 0)
+                        {
+                            left += Buffer[frame * Channels + ch];
+                        }
+                        else
+                        {
+                            right += Buffer[frame * Channels + ch];
+                        }
+                    }
+                    buffer[offset + 2 * frame] = left * scale;
+                    buffer[offset + 2 * frame + 1] = right * scale;
+                }
+                return read * 2;
+            }
+        }
+
+        /* Ogg Vorbis files, decoded by NVorbis */
+        private class VorbisWaveStream : WaveStream
+        {
+            private readonly VorbisReader Reader;
+            private float[] Buffer = new float[0];
+
+            public string Title => Reader.Tags?.Title;
+            public string Artist => Reader.Tags?.Artist;
+
+            public VorbisWaveStream(string fileName)
+            {
+                Reader = new VorbisReader(fileName);
+                WaveFormat = WaveFormat.CreateIeeeFloatWaveFormat(Reader.SampleRate, Reader.Channels);
+            }
+
+            public override WaveFormat WaveFormat { get; }
+
+            public override long Length => (long)(Reader.TotalTime.TotalSeconds * WaveFormat.AverageBytesPerSecond);
+
+            public override long Position
+            {
+                get => (long)(Reader.TimePosition.TotalSeconds * WaveFormat.AverageBytesPerSecond);
+                set => Reader.TimePosition = TimeSpan.FromSeconds((double)value / WaveFormat.AverageBytesPerSecond);
+            }
+
+            public override int Read(byte[] buffer, int offset, int count)
+            {
+                int samples = count / 4;
+                if (Buffer.Length < samples)
+                {
+                    Buffer = new float[samples];
+                }
+                int read = Reader.ReadSamples(Buffer, 0, samples);
+                System.Buffer.BlockCopy(Buffer, 0, buffer, offset, read * 4);
+                return read * 4;
+            }
+
+            protected override void Dispose(bool disposing)
+            {
+                if (disposing)
+                {
+                    Reader.Dispose();
+                }
+                base.Dispose(disposing);
+            }
+        }
+    }
+}
diff --git a/TonieAudio/Ogg.cs b/TonieAudio/Ogg.cs
new file mode 100644
index 0000000..cc281a4
--- /dev/null
+++ b/TonieAudio/Ogg.cs
@@ -0,0 +1,262 @@
+﻿using System;
+using System.Collections.Generic;
+
+namespace TonieFile
+{
+    /* minimal Ogg container support (RFC 3533) for Opus streams */
+    public static class Ogg
+    {
+        public const byte FlagContinued = 1;
+        public const byte FlagFirst = 2;
+        public const byte FlagLast = 4;
+        public const int HeaderSize = 27;
+
+        private static readonly uint[] CrcTable = BuildCrcTable();
+
+        private static uint[] BuildCrcTable()
+        {
+            var table = new uint[256];
+            for (uint index = 0; index < 256; index++)
+            {
+                uint crc = index << 24;
+                for (int bit = 0; bit < 8; bit++)
+                {
+                    crc = (crc & 0x80000000) != 0 ? (crc << 1) ^ 0x04C11DB7 : crc << 1;
+                }
+                table[index] = crc;
+            }
+            return table;
+        }
+
+        public static uint Crc(byte[] data, int offset, int length)
+        {
+            uint crc = 0;
+            for (int pos = offset; pos < offset + length; pos++)
+            {
+                crc = (crc << 8) ^ CrcTable[((crc >> 24) ^ data[pos]) & 0xFF];
+            }
+            return crc;
+        }
+
+        /* CRC of a stored page, computed with its checksum field as zero */
+        public static uint PageCrc(byte[] data, int offset, int length)
+        {
+            uint crc = 0;
+            for (int pos = offset; pos < offset + length; pos++)
+            {
+                byte value = (pos >= offset + 22 && pos < offset + 26) ? (byte)0 : data[pos];
+                crc = (crc << 8) ^ CrcTable[((crc >> 24) ^ value) & 0xFF];
+            }
+            return crc;
+        }
+
+        /* lacing values a packet of this size needs */
+        public static int LacingCount(int packetSize)
+        {
+            return packetSize / 255 + 1;
+        }
+
+        /* size of a page holding these complete packets */
+        public static int PageSize(IList<ArraySegment<byte>> packets)
+        {
+            int size = HeaderSize;
+            foreach (var packet in packets)
+            {
+                size += LacingCount(packet.Count) + packet.Count;
+            }
+            return size;
+        }
+
+        /* a page made of complete packets */
+        public static byte[] BuildPage(IList<ArraySegment<byte>> packets, byte flags, long granule, int serial, int sequence)
+        {
+            int lacing = 0;
+            foreach (var packet in packets)
+            {
+                lacing += LacingCount(packet.Count);
+            }
+            if (lacing > 255)
+            {
+                throw new ArgumentException("Too many segments for one Ogg page");
+            }
+
+            byte[] page = new byte[PageSize(packets)];
+            page[0] = (byte)'O';
+            page[1] = (byte)'g';
+            page[2] = (byte)'g';
+            page[3] = (byte)'S';
+            page[4] = 0;
+            page[5] = flags;
+            WriteLE(page, 6, (ulong)granule, 8);
+            WriteLE(page, 14, (uint)serial, 4);
+            WriteLE(page, 18, (uint)sequence, 4);
+            page[26] = (byte)lacing;
+
+            int segment = HeaderSize;
+            int data = HeaderSize + lacing;
+            foreach (var packet in packets)
+            {
+                for (int remaining = packet.Count; ; remaining -= 255)
+                {
+                    page[segment++] = (byte)Math.Min(remaining, 255);
+                    if (remaining < 255)
+                    {
+                        break;
+                    }
+                }
+                Array.Copy(packet.Array, packet.Offset, page, data, packet.Count);
+                data += packet.Count;
+            }
+
+            WriteLE(page, 22, Crc(page, 0, page.Length), 4);
+            return page;
+        }
+
+        public static void WriteLE(byte[] buffer, int offset, ulong value, int bytes)
+        {
+            for (int pos = 0; pos < bytes; pos++)
+            {
+                buffer[offset + pos] = (byte)(value >> (8 * pos));
+            }
+        }
+
+        public class Page
+        {
+            public int Offset;
+            public int Length;
+            public byte Flags;
+            public long Granule;
+            public int Serial;
+            public uint Sequence;
+            /* index of the first packet that starts on this page */
+            public int FirstPacket;
+            /* packets that end on this page */
+            public int PacketCount;
+            public bool CrcValid;
+        }
+
+        public class Packet
+        {
+            public byte[] Buffer;
+            public int Offset;
+            public int Length;
+            /* page the packet ends on */
+            public int Page;
+        }
+
+        public class Stream
+        {
+            public readonly List<Page> Pages = new List<Page>();
+            public readonly List<Packet> Packets = new List<Packet>();
+            /* bytes after the last complete page, e.g. a truncated file */
+            public int TrailingBytes;
+        }
+
+        /* parses pages and packets, packets may continue on following pages */
+        public static Stream Parse(byte[] data, int offset, int length)
+        {
+            var stream = new Stream();
+            int end = offset + length;
+            int pos = offset;
+            List<ArraySegment<byte>> pending = null;
+
+            while (pos + HeaderSize <= end && data[pos] == 'O' && data[pos + 1] == 'g' && data[pos + 2] == 'g' && data[pos + 3] == 'S')
+            {
+                int segments = data[pos + 26];
+                if (pos + HeaderSize + segments > end)
+                {
+                    break;
+                }
+                int payload = 0;
+                for (int seg = 0; seg < segments; seg++)
+                {
+                    payload += data[pos + HeaderSize + seg];
+                }
+                int pageLength = HeaderSize + segments + payload;
+                if (pos + pageLength > end)
+                {
+                    break;
+                }
+
+                var page = new Page
+                {
+                    Offset = pos,
+                    Length = pageLength,
+                    Flags = data[pos + 5],
+                    Granule = BitConverter.ToInt64(data, pos + 6),
+                    Serial = BitConverter.ToInt32(data, pos + 14),
+                    Sequence = BitConverter.ToUInt32(data, pos + 18),
+                    FirstPacket = stream.Packets.Count
+                };
+                page.CrcValid = PageCrc(data, pos, pageLength) == BitConverter.ToUInt32(data, pos + 22);
+
+                if ((page.Flags & FlagContinued) == 0)
+                {
+                    pending = null;
+                }
+
+                int dataPos = pos + HeaderSize + segments;
+                int packetStart = dataPos;
+                int packetLength = 0;
+                for (int seg = 0; seg < segments; seg++)
+                {
+                    int lace = data[pos + HeaderSize + seg];
+                    packetLength += lace;
+                    dataPos += lace;
+                    if (lace < 255)
+                    {
+                        var part = new ArraySegment<byte>(data, packetStart, packetLength);
+                        Packet packet;
+                        if (pending != null)
+                        {
+                            pending.Add(part);
+                            packet = Join(pending);
+                            pending = null;
+                        }
+                        else
+                        {
+                            packet = new Packet { Buffer = data, Offset = packetStart, Length = packetLength };
+                        }
+                        packet.Page = stream.Pages.Count;
+                        stream.Packets.Add(packet);
+                        page.PacketCount++;
+                        packetStart = dataPos;
+                        packetLength = 0;
+                    }
+                }
+                if (packetLength > 0 || (segments > 0 && data[pos + HeaderSize + segments - 1] == 255))
+                {
+                    /* continues on the next page */
+                    if (pending == null)
+                    {
+                        pending = new List<ArraySegment<byte>>();
+                    }
+                    pending.Add(new ArraySegment<byte>(data, packetStart, packetLength));
+                }
+
+                stream.Pages.Add(page);
+                pos += pageLength;
+            }
+
+            stream.TrailingBytes = end - pos;
+            return stream;
+        }
+
+        private static Packet Join(List<ArraySegment<byte>> parts)
+        {
+            int length = 0;
+            foreach (var part in parts)
+            {
+                length += part.Count;
+            }
+            byte[] buffer = new byte[length];
+            int pos = 0;
+            foreach (var part in parts)
+            {
+                Array.Copy(part.Array, part.Offset, buffer, pos, part.Count);
+                pos += part.Count;
+            }
+            return new Packet { Buffer = buffer, Offset = 0, Length = length };
+        }
+    }
+}
diff --git a/TonieAudio/OpusCodec.cs b/TonieAudio/OpusCodec.cs
new file mode 100644
index 0000000..a2538ac
--- /dev/null
+++ b/TonieAudio/OpusCodec.cs
@@ -0,0 +1,233 @@
+﻿using Concentus.Enums;
+using Concentus.Structs;
+using System;
+using System.Runtime.InteropServices;
+
+namespace TonieFile
+{
+    /* 48 kHz stereo Opus encoder working on 20 ms frames */
+    public interface IOpusEncoder : IDisposable
+    {
+        /* samples the decoder skips at the start (OpusHead pre-skip) */
+        int Lookahead { get; }
+
+        /* encodes 960 interleaved stereo samples, returns the packet size */
+        int Encode(float[] pcm, byte[] packet, int maxBytes);
+    }
+
+    public interface IOpusDecoder : IDisposable
+    {
+        /* decodes a packet into interleaved stereo samples, returns the samples per channel */
+        int Decode(byte[] packet, int offset, int length, float[] pcm);
+    }
+
+    /* uses the native libopus bundled with the app (libtonieopus) when it is there, else the managed Concentus port */
+    public static class OpusCodec
+    {
+        public const int SampleRate = 48000;
+        public const int Channels = 2;
+        public const int FrameSize = 960;
+
+        private static readonly string NativeVersion = LoadNative();
+
+        /* for tests and comparisons, TONIE_OPUS_MANAGED=1 selects Concentus */
+        public static bool ForceManaged { get; set; } = Environment.GetEnvironmentVariable("TONIE_OPUS_MANAGED") == "1";
+
+        public static bool UsesNative => NativeVersion != null && !ForceManaged;
+
+        public static string Name => UsesNative ? NativeVersion + " (native)" : "Concentus " + typeof(OpusEncoder).Assembly.GetName().Version + " (managed)";
+
+        private static string LoadNative()
+        {
+            try
+            {
+                return Marshal.PtrToStringAnsi(Native.tonie_opus_version());
+            }
+            catch (Exception)
+            {
+                /* DllNotFoundException, EntryPointNotFoundException or BadImageFormatException */
+                return null;
+            }
+        }
+
+        public static IOpusEncoder CreateEncoder(int bitRate, bool useVbr)
+        {
+            if (UsesNative)
+            {
+                return new NativeEncoder(bitRate, useVbr);
+            }
+            return new ManagedEncoder(bitRate, useVbr);
+        }
+
+        public static IOpusDecoder CreateDecoder()
+        {
+            if (UsesNative)
+            {
+                return new NativeDecoder();
+            }
+            return new ManagedDecoder();
+        }
+
+        /* grows a packet in place to newLength bytes using Opus padding, which decoders ignore */
+        public static bool Pad(byte[] packet, int length, int newLength)
+        {
+            if (newLength == length)
+            {
+                return true;
+            }
+            if (UsesNative)
+            {
+                return Native.tonie_opus_packet_pad(packet, length, newLength) == 0;
+            }
+            return OpusRepacketizer.PadPacket(packet, 0, length, newLength) == (int)OpusError.OPUS_OK;
+        }
+
+        private class NativeEncoder : IOpusEncoder
+        {
+            private IntPtr Handle;
+
+            public int Lookahead { get; }
+
+            public NativeEncoder(int bitRate, bool useVbr)
+            {
+                Handle = Native.tonie_opus_encoder_new(bitRate, useVbr ? 1 : 0, 10, out int lookahead, out int error);
+                if (Handle == IntPtr.Zero)
+                {
+                    throw new InvalidOperationException("Opus encoder could not be created (error " + error + ")");
+                }
+                Lookahead = lookahead;
+            }
+
+            public int Encode(float[] pcm, byte[] packet, int maxBytes)
+            {
+                int size = Native.tonie_opus_encode(Handle, pcm, FrameSize, packet, maxBytes);
+                if (size < 0)
+                {
+                    throw new InvalidOperationException("Opus encoding failed (error " + size + ")");
+                }
+                return size;
+            }
+
+            public void Dispose()
+            {
+                if (Handle != IntPtr.Zero)
+                {
+                    Native.tonie_opus_encoder_free(Handle);
+                    Handle = IntPtr.Zero;
+                }
+            }
+        }
+
+        private class NativeDecoder : IOpusDecoder
+        {
+            private IntPtr Handle;
+            private byte[] Scratch = new byte[1500];
+
+            public NativeDecoder()
+            {
+                Handle = Native.tonie_opus_decoder_new(out int error);
+                if (Handle == IntPtr.Zero)
+                {
+                    throw new InvalidOperationException("Opus decoder could not be created (error " + error + ")");
+                }
+            }
+
+            public int Decode(byte[] packet, int offset, int length, float[] pcm)
+            {
+                if (Scratch.Length < length)
+                {
+                    Scratch = new byte[length];
+                }
+                Array.Copy(packet, offset, Scratch, 0, length);
+                int samples = Native.tonie_opus_decode(Handle, Scratch, length, pcm, pcm.Length / Channels);
+                if (samples < 0)
+                {
+                    throw new InvalidOperationException("Opus decoding failed (error " + samples + ")");
+                }
+                return samples;
+            }
+
+            public void Dispose()
+            {
+                if (Handle != IntPtr.Zero)
+                {
+                    Native.tonie_opus_decoder_free(Handle);
+                    Handle = IntPtr.Zero;
+                }
+            }
+        }
+
+        private class ManagedEncoder : IOpusEncoder
+        {
+            private readonly OpusEncoder Encoder;
+            private readonly short[] Pcm16 = new short[FrameSize * Channels];
+
+            public int Lookahead => Encoder.Lookahead;
+
+            public ManagedEncoder(int bitRate, bool useVbr)
+            {
+                Encoder = OpusEncoder.Create(SampleRate, Channels, OpusApplication.OPUS_APPLICATION_AUDIO);
+                Encoder.Bitrate = bitRate;
+                Encoder.UseVBR = useVbr;
+            }
+
+            public int Encode(float[] pcm, byte[] packet, int maxBytes)
+            {
+                /* the 16 bit path, as teddy always used it */
+                for (int pos = 0; pos < Pcm16.Length; pos++)
+                {
+                    Pcm16[pos] = (short)Math.Max(short.MinValue, Math.Min(short.MaxValue, Math.Round(pcm[pos] * 32767)));
+                }
+                return Encoder.Encode(Pcm16, 0, FrameSize, packet, 0, maxBytes);
+            }
+
+            public void Dispose()
+            {
+            }
+        }
+
+        private class ManagedDecoder : IOpusDecoder
+        {
+            private readonly OpusDecoder Decoder = OpusDecoder.Create(SampleRate, Channels);
+
+            public int Decode(byte[] packet, int offset, int length, float[] pcm)
+            {
+                return Decoder.Decode(packet, offset, length, pcm, 0, pcm.Length / Channels, false);
+            }
+
+            public void Dispose()
+            {
+            }
+        }
+
+        /* libtonieopus: libopus plus fixed-argument wrappers, see native/tonie_opus.c */
+        private static class Native
+        {
+            private const string Lib = "tonieopus";
+
+            [DllImport(Lib)]
+            public static extern IntPtr tonie_opus_version();
+
+            [DllImport(Lib)]
+            public static extern IntPtr tonie_opus_encoder_new(int bitrate, int vbr, int complexity, out int lookahead, out int error);
+
+            [DllImport(Lib)]
+            public static extern int tonie_opus_encode(IntPtr encoder, float[] pcm, int frameSize, byte[] data, int maxBytes);
+
+            [DllImport(Lib)]
+            public static extern void tonie_opus_encoder_free(IntPtr encoder);
+
+            [DllImport(Lib)]
+            public static extern IntPtr tonie_opus_decoder_new(out int error);
+
+            [DllImport(Lib)]
+            public static extern int tonie_opus_decode(IntPtr decoder, byte[] data, int length, float[] pcm, int maxFrameSize);
+
+            [DllImport(Lib)]
+            public static extern void tonie_opus_decoder_free(IntPtr decoder);
+
+            [DllImport(Lib)]
+            public static extern int tonie_opus_packet_pad(byte[] data, int length, int newLength);
+        }
+    }
+}
diff --git a/TonieAudio/SpeexResamplingWaveProvider.cs b/TonieAudio/SpeexResamplingWaveProvider.cs
new file mode 100644
index 0000000..b5b9789
--- /dev/null
+++ b/TonieAudio/SpeexResamplingWaveProvider.cs
@@ -0,0 +1,106 @@
+﻿using Concentus.Common;
+using NAudio.Wave;
+using System;
+
+namespace TonieFile
+{
+    /* converts the sample rate of 16 bit PCM audio using the Speex resampler from Concentus.
+       managed replacement for MediaFoundationResampler, which only exists on Windows. */
+    public class SpeexResamplingWaveProvider : IWaveProvider
+    {
+        private readonly IWaveProvider Source;
+        private readonly SpeexResampler Resampler;
+        private readonly int Channels;
+        private readonly byte[] SourceBuffer;
+        private readonly short[] InSamples;
+        private short[] OutSamples = new short[0];
+        private int InFrames = 0;
+        private int InPos = 0;
+        private int FlushFrames;
+        private bool SourceDone = false;
+
+        public WaveFormat WaveFormat { get; }
+
+        public SpeexResamplingWaveProvider(IWaveProvider source, int sampleRate, int quality)
+        {
+            if (source.WaveFormat.Encoding != WaveFormatEncoding.Pcm || source.WaveFormat.BitsPerSample != 16)
+            {
+                throw new ArgumentException("Resampler needs 16 bit PCM input");
+            }
+
+            Source = source;
+            Channels = source.WaveFormat.Channels;
+            WaveFormat = new WaveFormat(sampleRate, 16, Channels);
+            SourceBuffer = new byte[4096 * 2 * Channels];
+            InSamples = new short[4096 * Channels];
+
+            Resampler = SpeexResampler.Create(Channels, source.WaveFormat.SampleRate, sampleRate, quality);
+            /* skip the filter delay at the start and feed the same amount of silence at the end, so the output has the same length */
+            Resampler.SkipZeroes();
+            FlushFrames = Resampler.InputLatency;
+        }
+
+        public int Read(byte[] buffer, int offset, int count)
+        {
+            int outFrames = count / (2 * Channels);
+            int doneFrames = 0;
+
+            if (OutSamples.Length < outFrames * Channels)
+            {
+                OutSamples = new short[outFrames * Channels];
+            }
+
+            while (doneFrames < outFrames)
+            {
+                if (InPos >= InFrames && !Refill())
+                {
+                    break;
+                }
+
+                int inLen = InFrames - InPos;
+                int outLen = outFrames - doneFrames;
+                Resampler.ProcessInterleaved(InSamples, InPos * Channels, ref inLen, OutSamples, doneFrames * Channels, ref outLen);
+
+                if (inLen == 0 && outLen == 0)
+                {
+                    throw new InvalidOperationException("Resampler made no progress");
+                }
+                InPos += inLen;
+                doneFrames += outLen;
+            }
+
+            int bytes = doneFrames * Channels * 2;
+            Buffer.BlockCopy(OutSamples, 0, buffer, offset, bytes);
+
+            return bytes;
+        }
+
+        private bool Refill()
+        {
+            InPos = 0;
+            InFrames = 0;
+
+            if (!SourceDone)
+            {
+                InFrames = Source.Read(SourceBuffer, 0, SourceBuffer.Length) / (2 * Channels);
+
+                if (InFrames > 0)
+                {
+                    Buffer.BlockCopy(SourceBuffer, 0, InSamples, 0, InFrames * Channels * 2);
+                    return true;
+                }
+                SourceDone = true;
+            }
+
+            if (FlushFrames > 0)
+            {
+                InFrames = Math.Min(FlushFrames, InSamples.Length / Channels);
+                Array.Clear(InSamples, 0, InFrames * Channels);
+                FlushFrames -= InFrames;
+                return true;
+            }
+
+            return false;
+        }
+    }
+}
