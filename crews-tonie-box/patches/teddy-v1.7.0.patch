+﻿using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text;
+
+namespace TonieFile
+{
+    /* Writes the Ogg Opus stream of a tonie file the way the Toniebox reads it:
+       - OpusHead and OpusTags take the first 0x200 bytes, the first audio page the rest of that 4 KiB block,
+         every further page is exactly 4 KiB, so no page crosses a 4 KiB block
+       - a full page is completed by padding its packets (Opus padding, which decoders skip) instead of
+         squeezing the next packet into the space that is left, which is audible
+       - every chapter starts on a new page, so skipping on the box lands exactly on the chapter start */
+    public class TonieOggWriter
+    {
+        private const int BlockSize = 0x1000;
+        private const int HeaderPagesSize = 0x200;
+        /* largest regular Opus packet (one 20 ms frame), padded packets stay within that */
+        private const int MaxPacketSize = 1275;
+        /* leave lacing values free on every page, padding a packet can need more of them */
+        private const int MaxLacingBeforePadding = 200;
+        /* OpusHead fields as in the original tonie files */
+        private const short PreSkip = 356;
+        private const int OriginalSampleRate = 44100;
+
+        private readonly Stream Output;
+        private readonly IOpusEncoder Encoder;
+        private readonly float[] Frame = new float[OpusCodec.FrameSize * OpusCodec.Channels];
+        private int FrameFill = 0;
+        private int ChapterFrames = 0;
+
+        /* packets of the page being filled, each buffer has room to be padded to MaxPacketSize */
+        private readonly List<byte[]> Packets = new List<byte[]>();
+        private readonly List<int> Sizes = new List<int>();
+
+        public int StreamId { get; }
+        public int PageSequence { get; private set; } = 0;
+        public long Granule { get; private set; } = 0;
+        public long BytesWritten { get; private set; } = 0;
+        public int PaddedBytes { get; private set; } = 0;
+        public int SilentFrames { get; private set; } = 0;
+
+        public TonieOggWriter(Stream output, IOpusEncoder encoder, int streamId)
+        {
+            Output = output;
+            Encoder = encoder;
+            StreamId = streamId;
+            WriteHeaderPages();
+        }
+
+        /* interleaved stereo samples, -1..1 */
+        public void WriteSamples(float[] samples, int offset, int count)
+        {
+            while (count > 0)
+            {
+                int take = Math.Min(count, Frame.Length - FrameFill);
+                Array.Copy(samples, offset, Frame, FrameFill, take);
+                FrameFill += take;
+                offset += take;
+                count -= take;
+
+                if (FrameFill == Frame.Length)
+                {
+                    EncodeFrame();
+                }
+            }
+        }
+
+        /* completes the last frame of a track with silence */
+        public void EndTrack()
+        {
+            if (FrameFill > 0 || ChapterFrames == 0)
+            {
+                Array.Clear(Frame, FrameFill, Frame.Length - FrameFill);
+                EncodeFrame();
+            }
+        }
+
+        /* starts the next chapter on a new page and returns the page number the tonie header refers to */
+        public uint StartChapter()
+        {
+            EndTrack();
+            if (Packets.Count > 0)
+            {
+                CompletePage(true);
+            }
+            ChapterFrames = 0;
+            return (uint)PageSequence;
+        }
+
+        public void Finish()
+        {
+            EndTrack();
+            /* the stream must not end at a 4 KiB boundary, see teddy's OpusOggWriteStream */
+            if (UsedBytes() == Capacity())
+            {
+                WritePage(0);
+                EncodeSilence();
+            }
+            WritePage(Ogg.FlagLast);
+            Output.Flush();
+        }
+
+        private void EncodeFrame()
+        {
+            byte[] packet = new byte[MaxPacketSize];
+            int size = Encoder.Encode(Frame, packet, MaxPacketSize);
+
+            FrameFill = 0;
+            ChapterFrames++;
+            if (!Fits(size))
+            {
+                CompletePage(false);
+            }
+            Packets.Add(packet);
+            Sizes.Add(size);
+            Granule += OpusCodec.FrameSize;
+        }
+
+        private void EncodeSilence()
+        {
+            Array.Clear(Frame, 0, Frame.Length);
+            FrameFill = Frame.Length;
+            EncodeFrame();
+            SilentFrames++;
+        }
+
+        /* bytes left in the current 4 KiB block */
+        private int Capacity()
+        {
+            return BlockSize - (int)(BytesWritten % BlockSize);
+        }
+
+        private int UsedBytes()
+        {
+            int used = Ogg.HeaderSize;
+            foreach (int size in Sizes)
+            {
+                used += Ogg.LacingCount(size) + size;
+            }
+            return used;
+        }
+
+        private int UsedLacing()
+        {
+            int lacing = 0;
+            foreach (int size in Sizes)
+            {
+                lacing += Ogg.LacingCount(size);
+            }
+            return lacing;
+        }
+
+        private bool Fits(int size)
+        {
+            return UsedBytes() + Ogg.LacingCount(size) + size <= Capacity() && UsedLacing() + Ogg.LacingCount(size) <= MaxLacingBeforePadding;
+        }
+
+        /* bytes a page grows by when a packet grows from one size to another */
+        private static int Growth(int from, int to)
+        {
+            return to + Ogg.LacingCount(to) - from - Ogg.LacingCount(from);
+        }
+
+        /* pads the packets of the current page so it exactly fills its 4 KiB block and writes it. at the end of
+           a chapter there may be more room than padding can take, then silent frames are added. */
+        private void CompletePage(bool chapterEnd)
+        {
+            while (true)
+            {
+                int free = Capacity() - UsedBytes();
+                int lacing = UsedLacing();
+
+                /* grow packets from the last one backwards, each as far as possible */
+                int[] grown = Sizes.ToArray();
+                for (int index = grown.Length - 1; index >= 0 && free > 0; index--)
+                {
+                    int size = grown[index];
+                    int target = size;
+                    while (target < MaxPacketSize && Growth(size, target + 1) <= free && lacing + Ogg.LacingCount(target + 1) - Ogg.LacingCount(size) <= 255)
+                    {
+                        target++;
+                    }
+                    free -= Growth(size, target);
+                    lacing += Ogg.LacingCount(target) - Ogg.LacingCount(size);
+                    grown[index] = target;
+                }
+
+                if (free == 0)
+                {
+                    for (int index = 0; index < grown.Length; index++)
+                    {
+                        if (!OpusCodec.Pad(Packets[index], Sizes[index], grown[index]))
+                        {
+                            throw new InvalidOperationException("Failed to pad an Opus packet from " + Sizes[index] + " to " + grown[index] + " bytes");
+                        }
+                        PaddedBytes += grown[index] - Sizes[index];
+                        Sizes[index] = grown[index];
+                    }
+                    WritePage(0);
+                    return;
+                }
+
+                if (!chapterEnd)
+                {
+                    throw new InvalidOperationException("Could not fill an Ogg page of the tonie file, " + free + " bytes left");
+                }
+
+                /* too much room left for padding alone: end the chapter with a silent frame */
+                int page = PageSequence;
+                EncodeSilence();
+                if (PageSequence != page)
+                {
+                    /* it did not fit and started the next page, the chapter begins there after 20 ms of silence */
+                    return;
+                }
+            }
+        }
+
+        private void WritePage(byte flags)
+        {
+            var segments = new List<ArraySegment<byte>>();
+            for (int index = 0; index < Packets.Count; index++)
+            {
+                segments.Add(new ArraySegment<byte>(Packets[index], 0, Sizes[index]));
+            }
+            byte[] page = Ogg.BuildPage(segments, flags, Granule, StreamId, PageSequence);
+
+            if (flags != Ogg.FlagLast && page.Length != Capacity())
+            {
+                throw new InvalidOperationException("Ogg page of " + page.Length + " bytes does not fill its 4 KiB block (" + Capacity() + " bytes)");
+            }
+
+            Output.Write(page, 0, page.Length);
+            BytesWritten += page.Length;
+            PageSequence++;
+            Packets.Clear();
+            Sizes.Clear();
+        }
+
+        private void WriteHeaderPages()
+        {
+            byte[] head = new byte[19];
+            Encoding.ASCII.GetBytes("OpusHead").CopyTo(head, 0);
+            head[8] = 1;
+            head[9] = (byte)OpusCodec.Channels;
+            Ogg.WriteLE(head, 10, (ushort)PreSkip, 2);
+            Ogg.WriteLE(head, 12, OriginalSampleRate, 4);
+            /* output gain and channel mapping family stay 0 */
+
+            byte[] headPage = Ogg.BuildPage(new[] { new ArraySegment<byte>(head) }, Ogg.FlagFirst, 0, StreamId, PageSequence++);
+            Output.Write(headPage, 0, headPage.Length);
+            BytesWritten += headPage.Length;
+
+            /* the same tags as teddy (and the original files) use, "pad" makes both pages exactly 0x200 bytes */
+            for (int pad = 0; pad < HeaderPagesSize; pad++)
+            {
+                byte[] tags = BuildTags(pad);
+                if (BytesWritten + Ogg.PageSize(new[] { new ArraySegment<byte>(tags) }) == HeaderPagesSize)
+                {
+                    byte[] tagsPage = Ogg.BuildPage(new[] { new ArraySegment<byte>(tags) }, 0, 0, StreamId, PageSequence++);
+                    Output.Write(tagsPage, 0, tagsPage.Length);
+                    BytesWritten += tagsPage.Length;
+                    return;
+                }
+            }
+            throw new InvalidOperationException("Could not size the OpusTags page");
+        }
+
+        private static byte[] BuildTags(int padLength)
+        {
+            var fields = new[]
+            {
+                "encoder=opusenc from opus-tools 0.1.9",
+                "encoder_options=--quiet --bitrate 96 --vbr",
+                "pad=" + new string('0', padLength)
+            };
+            var tags = new MemoryStream();
+            void Write(byte[] data) => tags.Write(data, 0, data.Length);
+            void WriteString(string value)
+            {
+                byte[] bytes = Encoding.UTF8.GetBytes(value);
+                Write(BitConverter.GetBytes(bytes.Length));
+                Write(bytes);
+            }
+
+            Write(Encoding.ASCII.GetBytes("OpusTags"));
+            WriteString("Lavf56.40.101");
+            Write(BitConverter.GetBytes(fields.Length));
+            foreach (string field in fields)
+            {
+                WriteString(field);
+            }
+            return tags.ToArray();
+        }
+    }
+}
diff --git a/TonieAudio/TonieStream.cs b/TonieAudio/TonieStream.cs
new file mode 100644
index 0000000..7ebdfb5
--- /dev/null
+++ b/TonieAudio/TonieStream.cs
@@ -0,0 +1,415 @@
+﻿using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text;
+
+namespace TonieFile
+{
+    /* the Ogg Opus stream of a tonie file, split into its chapters */
+    public class TonieStream
+    {
+        /* decoding a chapter from its first packet on sounds different from playing through: warm the decoder up first */
+        private const int PreRollSamples = 3840;
+
+        /* when a player asks for bytes in the middle of a chapter: long enough that the decoder output matches playing straight through */
+        private const int SeekPreRollSamples = 24000;
+
+        public class Chapter
+        {
+            public int Index;
+            /* first audio packet of the chapter and number of packets */
+            public int FirstPacket;
+            public int Packets;
+            public long Samples;
+            public double Seconds => Samples / 48000.0;
+        }
+
+        public readonly Ogg.Stream Ogg;
+        public readonly List<Chapter> Chapters = new List<Chapter>();
+        public readonly int PreSkip;
+        public readonly int Serial;
+        public long TotalSamples => Chapters.Sum(c => c.Samples);
+
+        /* chapterPages: the page numbers from the tonie header, the first chapter may be page 0 */
+        public TonieStream(byte[] audio, uint[] chapterPages)
+        {
+            Ogg = TonieFile.Ogg.Parse(audio, 0, audio.Length);
+            if (Ogg.Packets.Count < 3 || Ogg.Packets[0].Length < 19 || Encoding.ASCII.GetString(Ogg.Packets[0].Buffer, Ogg.Packets[0].Offset, 8) != "OpusHead")
+            {
+                throw new InvalidDataException("No Opus audio found");
+            }
+            var head = Ogg.Packets[0];
+            PreSkip = BitConverter.ToUInt16(head.Buffer, head.Offset + 10);
+            Serial = Ogg.Pages[0].Serial;
+
+            /* chapter starts as packet indexes, audio starts after OpusHead and OpusTags */
+            var starts = new List<int>();
+            foreach (uint pageNumber in (chapterPages == null || chapterPages.Length == 0) ? new uint[] { 0 } : chapterPages)
+            {
+                var page = Ogg.Pages.FirstOrDefault(p => p.Sequence >= pageNumber && p.FirstPacket >= 2);
+                int start = page == null ? Ogg.Packets.Count : Math.Max(2, page.FirstPacket);
+                if (starts.Count == 0)
+                {
+                    start = 2;
+                }
+                starts.Add(Math.Max(start, starts.LastOrDefault()));
+            }
+
+            for (int index = 0; index < starts.Count; index++)
+            {
+                int end = index + 1 < starts.Count ? starts[index + 1] : Ogg.Packets.Count;
+                var chapter = new Chapter { Index = index, FirstPacket = starts[index], Packets = end - starts[index] };
+                for (int packet = chapter.FirstPacket; packet < end; packet++)
+                {
+                    chapter.Samples += PacketSamples(Ogg.Packets[packet]);
+                }
+                if (index == 0)
+                {
+                    chapter.Samples = Math.Max(0, chapter.Samples - PreSkip);
+                }
+                Chapters.Add(chapter);
+            }
+        }
+
+        /* samples (48 kHz) in an Opus packet, from its TOC byte (RFC 6716, 3.1) */
+        public static int PacketSamples(TonieFile.Ogg.Packet packet)
+        {
+            if (packet.Length < 1)
+            {
+                return 0;
+            }
+            byte toc = packet.Buffer[packet.Offset];
+            int config = toc >> 3;
+            int frame;
+            if (config < 12)
+            {
+                frame = new[] { 480, 960, 1920, 2880 }[config & 3];
+            }
+            else if (config < 16)
+            {
+                frame = (config & 1) != 0 ? 960 : 480;
+            }
+            else
+            {
+                frame = 120 << (config & 3);
+            }
+            int frames;
+            switch (toc & 3)
+            {
+                case 0:
+                    frames = 1;
+                    break;
+                case 3:
+                    frames = packet.Length > 1 ? packet.Buffer[packet.Offset + 1] & 0x3F : 0;
+                    break;
+                default:
+                    frames = 2;
+                    break;
+            }
+            return frame * frames;
+        }
+
+        /* packets to decode ahead of a chapter (and drop) so it starts sounding like during normal playback */
+        private int PreRollStart(Chapter chapter)
+        {
+            int first = chapter.FirstPacket;
+            int samples = 0;
+            while (chapter.Index > 0 && first > 2 && samples < PreRollSamples)
+            {
+                first--;
+                samples += PacketSamples(Ogg.Packets[first]);
+            }
+            return first;
+        }
+
+        /* a standalone Ogg Opus file of one chapter, or of all of them for chapter -1 */
+        public byte[] ExtractOgg(int chapterIndex, IEnumerable<string> tags)
+        {
+            int first, count;
+            int preSkip;
+            if (chapterIndex < 0)
+            {
+                first = 2;
+                count = Ogg.Packets.Count - 2;
+                preSkip = PreSkip;
+            }
+            else
+            {
+                var chapter = Chapters[chapterIndex];
+                first = PreRollStart(chapter);
+                count = chapter.FirstPacket + chapter.Packets - first;
+                preSkip = chapterIndex == 0 ? PreSkip : 0;
+                for (int packet = first; packet < chapter.FirstPacket; packet++)
+                {
+                    preSkip += PacketSamples(Ogg.Packets[packet]);
+                }
+            }
+
+            var output = new MemoryStream();
+            int sequence = 0;
+
+            byte[] head = new byte[19];
+            Array.Copy(Ogg.Packets[0].Buffer, Ogg.Packets[0].Offset, head, 0, 19);
+            TonieFile.Ogg.WriteLE(head, 10, (ushort)Math.Min(preSkip, 65535), 2);
+            WritePage(output, new List<ArraySegment<byte>> { new ArraySegment<byte>(head) }, TonieFile.Ogg.FlagFirst, 0, ref sequence);
+            WritePage(output, new List<ArraySegment<byte>> { new ArraySegment<byte>(BuildTags(tags)) }, 0, 0, ref sequence);
+
+            var page = new List<ArraySegment<byte>>();
+            long granule = 0;
+            for (int index = first; index < first + count; index++)
+            {
+                var packet = Ogg.Packets[index];
+                var segment = new ArraySegment<byte>(packet.Buffer, packet.Offset, packet.Length);
+                page.Add(segment);
+                if (TonieFile.Ogg.PageSize(page) > 4096 || page.Sum(p => TonieFile.Ogg.LacingCount(p.Count)) > 255)
+                {
+                    page.RemoveAt(page.Count - 1);
+                    WritePage(output, page, 0, granule, ref sequence);
+                    page = new List<ArraySegment<byte>> { segment };
+                }
+                granule += PacketSamples(packet);
+            }
+            WritePage(output, page, TonieFile.Ogg.FlagLast, granule, ref sequence);
+            return output.ToArray();
+        }
+
+        private void WritePage(Stream output, List<ArraySegment<byte>> packets, byte flags, long granule, ref int sequence)
+        {
+            byte[] page = TonieFile.Ogg.BuildPage(packets, flags, granule, Serial, sequence++);
+            output.Write(page, 0, page.Length);
+        }
+
+        private static byte[] BuildTags(IEnumerable<string> tags)
+        {
+            var fields = (tags ?? Enumerable.Empty<string>()).Where(t => !string.IsNullOrEmpty(t) && t.Contains("=")).ToList();
+            var output = new MemoryStream();
+            void Write(byte[] data) => output.Write(data, 0, data.Length);
+            void WriteString(string value)
+            {
+                byte[] bytes = Encoding.UTF8.GetBytes(value);
+                Write(BitConverter.GetBytes(bytes.Length));
+                Write(bytes);
+            }
+            Write(Encoding.ASCII.GetBytes("OpusTags"));
+            WriteString("teddy");
+            Write(BitConverter.GetBytes(fields.Count));
+            foreach (string field in fields)
+            {
+                WriteString(field);
+            }
+            return output.ToArray();
+        }
+
+        /* decodes a chapter (or everything for -1) into a 16 bit, 48 kHz stereo WAV file */
+        public void DecodeWav(int chapterIndex, Stream output)
+        {
+            int first, count, skip;
+            long samples;
+            if (chapterIndex < 0)
+            {
+                first = 2;
+                count = Ogg.Packets.Count - 2;
+                skip = PreSkip;
+                samples = TotalSamples;
+            }
+            else
+            {
+                var chapter = Chapters[chapterIndex];
+                first = PreRollStart(chapter);
+                count = chapter.FirstPacket + chapter.Packets - first;
+                skip = chapterIndex == 0 ? PreSkip : 0;
+                for (int packet = first; packet < chapter.FirstPacket; packet++)
+                {
+                    skip += PacketSamples(Ogg.Packets[packet]);
+                }
+                samples = chapter.Samples;
+            }
+
+            WriteWavHeader(output, samples);
+            long remaining = samples;
+            var pcm = new float[5760 * 2];
+            var bytes = new byte[5760 * 4];
+            using (var decoder = OpusCodec.CreateDecoder())
+            {
+                for (int index = first; index < first + count && remaining > 0; index++)
+                {
+                    var packet = Ogg.Packets[index];
+                    int decoded = decoder.Decode(packet.Buffer, packet.Offset, packet.Length, pcm);
+                    int start = Math.Min(skip, decoded);
+                    skip -= start;
+                    int take = (int)Math.Min(decoded - start, remaining);
+                    for (int pos = 0; pos < take * 2; pos++)
+                    {
+                        short value = (short)Math.Max(short.MinValue, Math.Min(short.MaxValue, Math.Round(pcm[start * 2 + pos] * 32767)));
+                        bytes[2 * pos] = (byte)value;
+                        bytes[2 * pos + 1] = (byte)(value >> 8);
+                    }
+                    output.Write(bytes, 0, take * 4);
+                    remaining -= take;
+                }
+            }
+            /* keep the length promised in the header */
+            Array.Clear(bytes, 0, bytes.Length);
+            while (remaining > 0)
+            {
+                int take = (int)Math.Min(remaining, bytes.Length / 4);
+                output.Write(bytes, 0, take * 4);
+                remaining -= take;
+            }
+        }
+
+        private long[] packetStarts;
+
+        /* where each packet starts, in decoded samples counted from the first audio packet */
+        private long[] PacketStarts()
+        {
+            if (packetStarts == null)
+            {
+                var starts = new long[Ogg.Packets.Count + 1];
+                long position = 0;
+                for (int index = 2; index < Ogg.Packets.Count; index++)
+                {
+                    starts[index] = position;
+                    position += PacketSamples(Ogg.Packets[index]);
+                }
+                starts[Ogg.Packets.Count] = position;
+                packetStarts = starts;
+            }
+            return packetStarts;
+        }
+
+        /* length of the WAV file DecodeWav writes for a chapter */
+        public long WavLength(int chapterIndex) => 44 + Chapters[chapterIndex].Samples * 4;
+
+        /* bytes [from, from + count) of the WAV file DecodeWav writes for a chapter, decoded on the fly:
+           a player can start or jump anywhere without the whole (possibly huge) file being made first */
+        public IEnumerable<ArraySegment<byte>> WavRange(int chapterIndex, long from, long count)
+        {
+            var chapter = Chapters[chapterIndex];
+            var header = new MemoryStream();
+            WriteWavHeader(header, chapter.Samples);
+            byte[] head = header.ToArray();
+            long end = Math.Min(from + count, WavLength(chapterIndex));
+            if (from < head.Length && from < end)
+            {
+                int take = (int)Math.Min(head.Length - from, end - from);
+                yield return new ArraySegment<byte>(head, (int)from, take);
+                from += take;
+            }
+            if (from >= end)
+            {
+                yield break;
+            }
+
+            long dataOffset = from - head.Length;
+            int skipBytes = (int)(dataOffset % 4);
+            long remaining = end - from;
+            var starts = PacketStarts();
+            int last = chapter.FirstPacket + chapter.Packets;
+            long target = (chapterIndex == 0 ? PreSkip : starts[chapter.FirstPacket]) + dataOffset / 4;
+
+            /* the packet holding the first wanted sample, and some packets before it to warm the decoder up */
+            int packet = chapter.FirstPacket;
+            int low = chapter.FirstPacket, high = last - 1;
+            while (low <= high)
+            {
+                int middle = (low + high) / 2;
+                if (starts[middle] <= target)
+                {
+                    packet = middle;
+                    low = middle + 1;
+                }
+                else
+                {
+                    high = middle - 1;
+                }
+            }
+            int first = packet;
+            while (first > 2 && target - starts[first] < SeekPreRollSamples)
+            {
+                first--;
+            }
+            long discard = target - starts[first];
+
+            var pcm = new float[5760 * 2];
+            var bytes = new byte[5760 * 4];
+            using (var decoder = OpusCodec.CreateDecoder())
+            {
+                for (int index = first; index < last && remaining > 0; index++)
+                {
+                    int decoded = DecodeOrSilence(decoder, Ogg.Packets[index], pcm);
+                    int start = (int)Math.Min(discard, decoded);
+                    discard -= start;
+                    int samples = decoded - start;
+                    if (samples <= 0)
+                    {
+                        continue;
+                    }
+                    ToPcm16(pcm, start, samples, bytes);
+                    int take = (int)Math.Min(samples * 4 - skipBytes, remaining);
+                    yield return new ArraySegment<byte>(bytes, skipBytes, take);
+                    skipBytes = 0;
+                    remaining -= take;
+                }
+            }
+            /* keep the length promised in the header */
+            Array.Clear(bytes, 0, bytes.Length);
+            while (remaining > 0)
+            {
+                int take = (int)Math.Min(remaining, bytes.Length);
+                yield return new ArraySegment<byte>(bytes, 0, take);
+                remaining -= take;
+            }
+        }
+
+        /* a damaged packet plays as silence instead of stopping everything */
+        private static int DecodeOrSilence(IOpusDecoder decoder, TonieFile.Ogg.Packet packet, float[] pcm)
+        {
+            try
+            {
+                int decoded = decoder.Decode(packet.Buffer, packet.Offset, packet.Length, pcm);
+                if (decoded >= 0)
+                {
+                    return decoded;
+                }
+            }
+            catch (Exception)
+            {
+            }
+            int samples = Math.Min(PacketSamples(packet), pcm.Length / 2);
+            Array.Clear(pcm, 0, samples * 2);
+            return samples;
+        }
+
+        private static void ToPcm16(float[] pcm, int start, int samples, byte[] bytes)
+        {
+            for (int pos = 0; pos < samples * 2; pos++)
+            {
+                short value = (short)Math.Max(short.MinValue, Math.Min(short.MaxValue, Math.Round(pcm[start * 2 + pos] * 32767)));
+                bytes[2 * pos] = (byte)value;
+                bytes[2 * pos + 1] = (byte)(value >> 8);
+            }
+        }
+
+        public static void WriteWavHeader(Stream output, long samples)
+        {
+            long dataBytes = samples * 4;
+            var header = new MemoryStream();
+            void Write(byte[] data) => header.Write(data, 0, data.Length);
+            Write(Encoding.ASCII.GetBytes("RIFF"));
+            Write(BitConverter.GetBytes((uint)Math.Min(uint.MaxValue, 36 + dataBytes)));
+            Write(Encoding.ASCII.GetBytes("WAVEfmt "));
+            Write(BitConverter.GetBytes(16));
+            Write(BitConverter.GetBytes((short)1));
+            Write(BitConverter.GetBytes((short)2));
+            Write(BitConverter.GetBytes(48000));
+            Write(BitConverter.GetBytes(48000 * 4));
+            Write(BitConverter.GetBytes((short)4));
+            Write(BitConverter.GetBytes((short)16));
+            Write(Encoding.ASCII.GetBytes("data"));
+            Write(BitConverter.GetBytes((uint)Math.Min(uint.MaxValue, dataBytes)));
+            header.WriteTo(output);
+        }
+    }
+}
