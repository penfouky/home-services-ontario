<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>CrewsTonieBox</AssemblyName>
    <RootNamespace>CrewsTonieBox</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- no IIS and no static web assets pipeline here: the UI is embedded (see below) -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <DebugType>embedded</DebugType>
    <!-- teddy's sources, fetched and patched by build.sh -->
    <TeddySrc Condition="'$(TeddySrc)' == ''">$(MSBuildThisFileDirectory)../build/teddy-src</TeddySrc>
    <NativeDir Condition="'$(NativeDir)' == ''">$(MSBuildThisFileDirectory)../build/native</NativeDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(TeddySrc)/TonieAudio/TonieAudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="3.2.3" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- the UI and the tonies database snapshot live inside the executable -->
    <Content Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/**" />
    <EmbeddedResource Include="Resources/toniesV2.json.gz" Condition="Exists('Resources/toniesV2.json.gz')" LogicalName="toniesV2.json.gz" />
  </ItemGroup>

  <ItemGroup>
    <!-- libopus built by native/build-opus.sh, next to the executable (also for single-file builds) -->
    <None Include="$(NativeDir)/$(RuntimeIdentifier)/libtonieopus.*" Condition="'$(RuntimeIdentifier)' != ''" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Link="%(Filename)%(Extension)" />
    <None Include="$(NativeDir)/linux-x64/libtonieopus.so" Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))" CopyToOutputDirectory="PreserveNewest" Link="libtonieopus.so" />
    <!-- the window icon; in the Mac app bundle it goes to Contents/Resources -->
    <None Include="Resources/icon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Link="icon.png" />
  </ItemGroup>
</Project>
