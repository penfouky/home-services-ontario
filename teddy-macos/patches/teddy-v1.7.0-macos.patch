+        /* the ACM MP3 codec and MediaFoundationResampler only exist on Windows, use managed code elsewhere */
+        private static bool UseWindowsCodecs => RuntimeInformation.IsOSPlatform(OSPlatform.Windows);
+
+        /* Speex quality 5: 80 taps, ~100 dB stopband, passband up to 20 kHz for 44.1 kHz sources */
+        private const int ResamplerQuality = 5;
+
+        private static WaveStream OpenMp3(string fileName)
+        {
+            if (UseWindowsCodecs)
+            {
+                /* same as NAudio's Mp3FileReader */
+                return new Mp3FileReaderBase(fileName, format => new AcmMp3FrameDecompressor(format));
+            }
+            return new Mp3FileReaderBase(fileName, format => new Mp3FrameDecompressor(format));
+        }
+
+        /* returns the stream's audio as 16 bit PCM in the given sampling rate and channel count */
+        private static IWaveProvider ConvertFormat(WaveStream stream, WaveFormat outFormat)
+        {
+            if (UseWindowsCodecs)
+            {
+                return new MediaFoundationResampler(stream, outFormat);
+            }
+
+            ISampleProvider samples = stream.ToSampleProvider();
+
+            if (samples.WaveFormat.Channels == 1 && outFormat.Channels == 2)
+            {
+                samples = new MonoToStereoSampleProvider(samples);
+            }
+            else if (samples.WaveFormat.Channels != outFormat.Channels)
+            {
+                throw new InvalidDataException("Unsupported number of channels: " + samples.WaveFormat.Channels);
+            }
+
+            IWaveProvider pcm = new SampleToWaveProvider16(samples);
+
+            if (pcm.WaveFormat.SampleRate != outFormat.SampleRate)
+            {
+                pcm = new SpeexResamplingWaveProvider(pcm, outFormat.SampleRate, ResamplerQuality);
+            }
+
+            return new FullReadWaveProvider(pcm);
+        }
+
+        /* ConvertToFloat() always converts the whole buffer, so a read must only come up short at the end of the stream */
+        private class FullReadWaveProvider : IWaveProvider
+        {
+            private readonly IWaveProvider Source;
+
+            public FullReadWaveProvider(IWaveProvider source)
+            {
+                Source = source;
+            }
+
+            public WaveFormat WaveFormat => Source.WaveFormat;
+
+            public int Read(byte[] buffer, int offset, int count)
+            {
+                int total = 0;
+
+                while (total < count)
+                {
+                    int read = Source.Read(buffer, offset + total, count - total);
+
+                    if (read <= 0)
+                    {
+                        break;
+                    }
+                    total += read;
+                }
+                return total;
+            }
+        }
+
