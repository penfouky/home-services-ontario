# Copy to ops/.env and fill in. Keep this file private (chmod 600). Nothing here is committed.

# --- what to back up -------------------------------------------------------------------------
TC_CONTAINER=teddycloud            # the running TeddyCloud container name (docker ps)
# BACKUP_PATHS="/teddycloud/certs /teddycloud/config /teddycloud/data/firmware /teddycloud/data/library /teddycloud/data/content"

# --- where backups go (set at least one) -----------------------------------------------------
BACKUP_DIR=/opt/crews-tonie-cloud/backups     # a local/mounted dir (ideally on separate storage)
RCLONE_REMOTE=                                 # e.g. gdrive:tonie-backups  (run `rclone config` first)
BACKUP_KEEP=14                                 # how many archives to keep

# --- backup encryption ------------------------------------------------------------------------
# Put a long random passphrase in this file (chmod 600). WITHOUT IT A BACKUP CANNOT BE RESTORED,
# so also store the passphrase somewhere safe off the server (a password manager).
BACKUP_PASSPHRASE_FILE=/opt/crews-tonie-cloud/ops/backup.passphrase

# --- watchdog: what "healthy" looks like ------------------------------------------------------
ADMIN_URL=https://tonie.coladabuilds.com/      # what you open in a browser
TLS_HOST=tonie.coladabuilds.com:443            # host:port to check the certificate on
TLS_MIN_DAYS=14
DISK_PATH=/
DISK_MIN_PCT=10
BACKUP_MAX_AGE_H=48

# --- watchdog: where alerts go (set at least one) --------------------------------------------
# A webhook that accepts a POST body works for ntfy.sh, Slack/Discord incoming webhooks, etc.
ALERT_WEBHOOK=
ALERT_EMAIL=
HEARTBEAT=0                                     # 1 = also send an all-clear every run
