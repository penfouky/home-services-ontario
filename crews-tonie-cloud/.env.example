# Copy to .env and fill in. deploy.sh does this for you and generates GATE_SECRET.

# The domain the Toniebox and you will use. Point its DNS A (and AAAA) record at this VPS.
# You reach the admin UI at https://<TC_DOMAIN>:8443 ; the box uses <TC_DOMAIN>:443.
TC_DOMAIN=tonie.coladabuilds.com

# Email for the Let's Encrypt certificate (used only for expiry notices).
ACME_EMAIL=you@example.com

# The single password for the branded admin login screen. Make it long.
GATE_PASSWORD=change-me-to-a-long-passphrase

# Signs the login cookie. Leave blank and deploy.sh fills it, or: openssl rand -hex 32
GATE_SECRET=

# Wording on the login screen.
GATE_BRAND=Colada Builds
GATE_TAGLINE=Crew's Tonie Cloud

# Run TeddyCloud as this user/group. On the VPS: id -u  and  id -g
PUID=1000
PGID=1000
TZ=America/Toronto
