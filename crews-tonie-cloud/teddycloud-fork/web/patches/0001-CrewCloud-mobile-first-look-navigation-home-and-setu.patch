+++ b/src/components/setup/useSetupStatus.ts
@@ -0,0 +1,118 @@
+import { useCallback, useEffect, useMemo, useState } from "react";
+import { TeddyCloudApi } from "../../api";
+import { defaultAPIConfig } from "../../config/defaultApiConfig";
+import { useTonieboxes } from "../../hooks/useTonieboxes";
+import { useTonies } from "../../hooks/useTonies";
+import { TonieCardProps } from "../../types/tonieTypes";
+
+const api = new TeddyCloudApi(defaultAPIConfig());
+
+export type SetupStepKey = "server" | "box" | "tonie" | "audio" | "assign";
+
+export interface SetupStep {
+    key: SetupStepKey;
+    done: boolean;
+}
+
+/** Reads a boolean setting. Returns null when the server doesn't have that setting. */
+const readBool = async (key: string): Promise<boolean | null> => {
+    try {
+        const response = await api.apiGetTeddyCloudSettingRaw(key);
+        return (await response.text()).trim().toLowerCase() === "true";
+    } catch {
+        return null;
+    }
+};
+
+/**
+ * Works out setup progress from data the server already has: a connected box, tonies seen by it,
+ * audio in the library, and a tonie that plays custom audio. Pure, so pages that already loaded
+ * boxes and tonies (like Home) don't need to fetch them again.
+ */
+export const computeSetup = (boxCount: number, tonies: TonieCardProps[], libraryCount: number) => {
+    const tags = tonies.filter((t) => t.type === "tag");
+    const steps: SetupStep[] = [
+        { key: "server", done: true },
+        { key: "box", done: boxCount > 0 },
+        { key: "tonie", done: tags.length > 0 },
+        { key: "audio", done: libraryCount > 0 },
+        { key: "assign", done: tags.some((t) => !!t.source && t.source.trim() !== "") },
+    ];
+    const doneCount = steps.filter((s) => s.done).length;
+    return {
+        steps,
+        doneCount,
+        total: steps.length,
+        complete: doneCount === steps.length,
+        nextStep: steps.find((s) => !s.done)?.key,
+    };
+};
+
+/** Number of entries in the library root (null while loading). */
+export const useLibraryCount = () => {
+    const [count, setCount] = useState<number | null>(null);
+    useEffect(() => {
+        (async () => {
+            try {
+                const response = await api.apiGetTeddyCloudApiRaw(
+                    "/api/fileIndexV2?path=&special=library",
+                );
+                const json = await response.json();
+                const entries = Array.isArray(json?.files) ? json.files : [];
+                setCount(entries.filter((f: { name?: string }) => f?.name !== "..").length);
+            } catch {
+                setCount(0);
+            }
+        })();
+    }, []);
+    return count;
+};
+
+/** Full status for the setup page, including the settings it can switch. */
+export const useSetupStatus = () => {
+    const { tonieboxes, loading: loadingBoxes } = useTonieboxes();
+    const { tonies, loading: loadingTonies } = useTonies({ merged: false, filter: "tag" });
+    const libraryCount = useLibraryCount();
+
+    const [allowNewBox, setAllowNewBox] = useState<boolean | null>(null);
+    const [normalize, setNormalize] = useState<boolean | null>(null);
+    const [useFrontend, setUseFrontend] = useState<boolean | null>(null);
+
+    const refreshSettings = useCallback(async () => {
+        const [a, n, f] = await Promise.all([
+            readBool("core.allowNewBox"),
+            readBool("encode.normalize"),
+            readBool("encode.use_frontend"),
+        ]);
+        setAllowNewBox(a);
+        setNormalize(n);
+        setUseFrontend(f);
+    }, []);
+
+    useEffect(() => {
+        refreshSettings();
+    }, [refreshSettings]);
+
+    /** Writes a boolean setting and re-reads it, so the UI reflects what the server stored. */
+    const setBoolSetting = useCallback(
+        async (key: string, value: boolean) => {
+            await api.apiPostTeddyCloudSetting(key, value);
+            await refreshSettings();
+        },
+        [refreshSettings],
+    );
+
+    const setup = useMemo(
+        () => computeSetup(tonieboxes.length, tonies, libraryCount ?? 0),
+        [tonieboxes.length, tonies, libraryCount],
+    );
+
+    return {
+        ...setup,
+        loading: loadingBoxes || loadingTonies || libraryCount === null,
+        allowNewBox,
+        normalize,
+        useFrontend,
+        setBoolSetting,
+    };
+};
