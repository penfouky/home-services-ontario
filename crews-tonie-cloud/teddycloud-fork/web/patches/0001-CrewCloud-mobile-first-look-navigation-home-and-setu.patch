+                        {t("crewcloud.setup.recommended", "Recommended settings")}
+                    </h3>
+                    {status.normalize !== null && (
+                        <ToggleRow $border={token.colorBorderSecondary}>
+                            <span>
+                                <b>{t("crewcloud.setup.normalize", "Even out the volume")}</b>
+                                <div style={{ color: token.colorTextSecondary, fontSize: 14 }}>
+                                    {t(
+                                        "crewcloud.setup.normalizeHint",
+                                        "Quiet and loud recordings end up at a similar volume on the box.",
+                                    )}
+                                </div>
+                            </span>
+                            <Switch
+                                checked={status.normalize}
+                                loading={saving === "encode.normalize"}
+                                onChange={(v) => toggle("encode.normalize", v)}
+                            />
+                        </ToggleRow>
+                    )}
+                    {status.useFrontend !== null && (
+                        <ToggleRow $border={token.colorBorderSecondary}>
+                            <span>
+                                <b>
+                                    {t(
+                                        "crewcloud.setup.browserEncode",
+                                        "Convert audio in the browser",
+                                    )}
+                                </b>
+                                <div style={{ color: token.colorTextSecondary, fontSize: 14 }}>
+                                    {t(
+                                        "crewcloud.setup.browserEncodeHint",
+                                        "Uploads are many times smaller, which is quicker on mobile data.",
+                                    )}
+                                </div>
+                            </span>
+                            <Switch
+                                checked={status.useFrontend}
+                                loading={saving === "encode.use_frontend"}
+                                onChange={(v) => toggle("encode.use_frontend", v)}
+                            />
+                        </ToggleRow>
+                    )}
+                    {(status.normalize === false || status.useFrontend === false) && (
+                        <Button
+                            type="primary"
+                            size="large"
+                            block
+                            style={{ marginTop: 8, maxWidth: 360 }}
+                            loading={saving === "recommended"}
+                            onClick={useRecommended}
+                            data-testid="setup-use-recommended"
+                        >
+                            {t("crewcloud.setup.useRecommended", "Use recommended settings")}
+                        </Button>
+                    )}
+                </div>
+            )}
+        </div>
+    );
+};
