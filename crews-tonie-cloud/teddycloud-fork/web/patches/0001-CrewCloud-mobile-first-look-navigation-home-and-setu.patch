+/**
+ * CrewCloud brand constants.
+ *
+ * CrewCloud is a friendlier, mobile-first edition of the open-source TeddyCloud web UI.
+ * The product name shown to people is BRAND_NAME; UPSTREAM_NAME is kept for honest
+ * attribution (TeddyCloud is GPL-licensed) and for places that link to the upstream
+ * project's wiki, forum, releases and support channels.
+ */
+export const BRAND_NAME = "CrewCloud";
+export const UPSTREAM_NAME = "TeddyCloud";
+
+export const brandColors = {
+    pink: "#ff8fab",
+    purple: "#8b6df2",
+    purpleDeep: "#6f54d6",
+    purpleSoft: "#f1ecfe",
+    gold: "#ffd166",
+    ink: "#3a2f5b",
+    mint: "#3fbf9a",
+} as const;
+
+export const brandGradient = "linear-gradient(135deg, #ff8fab 0%, #8b6df2 100%)";
+export const brandGradientDark = "linear-gradient(135deg, #a8577a 0%, #5b43bd 100%)";
+
+export const fontBody =
+    '"Nunito Variable", "Nunito", ui-rounded, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, system-ui, sans-serif';
+export const fontDisplay =
+    '"Fredoka Variable", "Fredoka", "Nunito Variable", ui-rounded, -apple-system, "Segoe UI", system-ui, sans-serif';
+
+/** The breakpoint below which the phone layout (tab bar, bottom sheets) is used. */
+export const MOBILE_MAX_WIDTH = 767;
+
+/** Height of the bottom tab bar on phones, without the device safe-area inset. */
+export const TAB_BAR_HEIGHT = 64;
