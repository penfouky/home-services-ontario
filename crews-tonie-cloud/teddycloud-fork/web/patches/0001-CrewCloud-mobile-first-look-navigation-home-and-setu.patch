+/* CrewCloud global styles: brand typography plus phone-friendly defaults that apply to every
+   page, so individual screens don't each need their own mobile fixes. */
+
+body {
+    font-family:
+        "Nunito Variable",
+        "Nunito",
+        ui-rounded,
+        -apple-system,
+        BlinkMacSystemFont,
+        "Segoe UI",
+        Roboto,
+        system-ui,
+        sans-serif;
+    -webkit-tap-highlight-color: transparent;
+}
+
+h1,
+h2,
+h3,
+h4,
+.ant-typography h1,
+.ant-typography h2,
+.ant-typography h3,
+.ant-modal-title,
+.ant-drawer-title,
+.crew-display {
+    font-family:
+        "Fredoka Variable", "Fredoka", "Nunito Variable", ui-rounded, system-ui, sans-serif;
+    font-weight: 600;
+    letter-spacing: 0.1px;
+}
+
+/* matrix easter egg keeps its monospace look */
+body.matrix-theme,
+body.matrix-theme h1,
+body.matrix-theme h2,
+body.matrix-theme h3 {
+    font-family: inherit;
+}
+
+/* bottom sheets used for navigation on phones */
+.crew-sheet .ant-drawer-content {
+    border-radius: 22px 22px 0 0;
+}
+.crew-sheet .ant-drawer-header {
+    border-bottom: 0;
+    padding-bottom: 4px;
+}
+.crew-sheet .ant-drawer-body {
+    padding-top: 4px;
+    padding-bottom: calc(16px + env(safe-area-inset-bottom));
+}
+.crew-sheet .ant-menu {
+    border-inline-end: 0 !important;
+    background: transparent;
+}
+
+@media (max-width: 767px) {
+    /* 16px inputs stop iOS Safari from zooming the page when a field is focused */
+    input,
+    textarea,
+    select,
+    .ant-input,
+    .ant-input-affix-wrapper input,
+    .ant-select-selection-search-input,
+    .ant-select-selection-item,
+    .ant-input-number-input,
+    .ant-picker-input > input {
+        font-size: 16px !important;
+    }
+
+    h1 {
+        font-size: 28px;
+        line-height: 1.2;
+        margin: 4px 0 12px;
+    }
+    h2 {
+        font-size: 22px;
+        line-height: 1.25;
+    }
+    h3 {
+        font-size: 19px;
+    }
+
+    /* breadcrumbs duplicate the section bar on phones and cost a whole row */
+    .crew-breadcrumb {
+        display: none !important;
+    }
+
+    /* dialogs use (almost) the whole phone screen instead of a narrow floating box */
+    .ant-modal {
+        max-width: calc(100vw - 16px) !important;
+        margin: 8px auto !important;
+        top: 8px !important;
+        padding-bottom: 8px !important;
+    }
+    .ant-modal .ant-modal-content {
+        padding: 18px 16px;
+        border-radius: 20px;
+    }
+
+    /* wide tables scroll sideways inside their card instead of breaking the page */
+    .ant-table-wrapper {
+        overflow-x: auto;
+        -webkit-overflow-scrolling: touch;
+    }
+
+    /* upload drop zones: a big, obvious tap target */
+    .ant-upload-wrapper .ant-upload-drag {
+        border-radius: 18px;
+    }
+    .ant-upload-wrapper .ant-upload-drag .ant-upload {
+        padding: 28px 12px;
+    }
+
+    /* notifications sit above the tab bar instead of covering the header */
+    .ant-notification-bottom {
+        margin-bottom: calc(72px + env(safe-area-inset-bottom)) !important;
+    }
+
+    /* tidy lists and descriptions on narrow screens */
+    .ant-descriptions-item-label,
+    .ant-descriptions-item-content {
+        font-size: 15px;
+    }
+}
