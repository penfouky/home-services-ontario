+import type { ThemeConfig } from "antd";
+import { brandColors, fontBody } from "./brand";
+
+type Mode = "light" | "dark" | "matrix";
+
+/**
+ * The CrewCloud Ant Design theme.
+ *
+ * Phones get a larger base font (16px, which also stops iOS from zooming into inputs) and
+ * 44px+ touch targets, following platform guidance for comfortable tapping. The matrix easter-egg
+ * theme keeps its own colours, so brand colours are only applied to light and dark.
+ */
+export const buildCrewTheme = (
+    mode: Mode,
+    isMobile: boolean,
+    algorithm: ThemeConfig["algorithm"],
+): ThemeConfig => {
+    const brand = mode !== "matrix";
+    const dark = mode === "dark";
+
+    return {
+        algorithm,
+        token: {
+            ...(brand
+                ? {
+                      colorPrimary: dark ? "#9d85f5" : brandColors.purple,
+                      colorLink: dark ? "#b3a1f8" : brandColors.purpleDeep,
+                      colorInfo: dark ? "#9d85f5" : brandColors.purple,
+                      colorBgLayout: dark ? "#120f22" : "#f7f3fb",
+                      colorBgContainer: dark ? "#1d1932" : "#ffffff",
+                      colorBgElevated: dark ? "#262142" : "#ffffff",
+                      colorBorderSecondary: dark ? "#2f2950" : "#efe8f7",
+                  }
+                : {}),
+            fontFamily: fontBody,
+            fontSize: isMobile ? 16 : 15,
+            fontSizeHeading1: isMobile ? 28 : 34,
+            fontSizeHeading2: isMobile ? 22 : 26,
+            fontSizeHeading3: isMobile ? 19 : 21,
+            fontSizeHeading4: isMobile ? 17 : 18,
+            lineHeight: 1.55,
+            borderRadius: isMobile ? 12 : 10,
+            borderRadiusLG: 18,
+            borderRadiusSM: 8,
+            controlHeight: isMobile ? 44 : 36,
+            controlHeightLG: isMobile ? 52 : 44,
+            controlHeightSM: isMobile ? 34 : 28,
+            wireframe: false,
+        },
+        components: {
+            // kept from the upstream theme
+            Slider: {
+                dotSize: 3,
+                handleSize: isMobile ? 10 : 6,
+                handleSizeHover: isMobile ? 12 : 8,
+                railSize: isMobile ? 6 : 4,
+            },
+            Popover: {
+                titleMinWidth: 0,
+            },
+            // CrewCloud
+            Button: {
+                fontWeight: 700,
+                primaryShadow: brand ? "0 6px 16px rgba(139, 109, 242, 0.28)" : undefined,
+            },
+            Menu: {
+                itemHeight: isMobile ? 50 : 40,
+                itemBorderRadius: 12,
+                iconSize: isMobile ? 18 : 16,
+                ...(brand && !dark
+                    ? {
+                          itemSelectedBg: brandColors.purpleSoft,
+                          itemSelectedColor: brandColors.purpleDeep,
+                      }
+                    : {}),
+            },
+            Card: {
+                borderRadiusLG: 18,
+            },
+            Tabs: {
+                titleFontSize: isMobile ? 16 : 15,
+            },
+            Switch: isMobile ? { trackHeight: 28, trackMinWidth: 50, handleSize: 24 } : {},
+        },
+    };
+};
