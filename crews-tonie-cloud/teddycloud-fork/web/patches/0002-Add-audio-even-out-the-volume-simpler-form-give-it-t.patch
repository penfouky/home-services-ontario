index 0000000..e743af3
--- /dev/null
+++ b/src/utils/audio/loudness.ts
@@ -0,0 +1,283 @@
+/**
+ * Loudness levelling for audio converted in the browser.
+ *
+ * Measures integrated loudness (ITU-R BS.1770 / EBU R128: K-weighting, 400 ms blocks with 75 %
+ * overlap, absolute gate at -70 LUFS and relative gate at -10 LU), then applies one gain so every
+ * track lands at the same loudness. Where that gain would push peaks past the ceiling, a
+ * look-ahead peak limiter pulls just those moments down, so quiet recordings with a few loud
+ * spikes still get levelled instead of clipping.
+ *
+ * Same target as the server's ffmpeg loudnorm (-16 LUFS), so tracks sound alike whichever way they
+ * were converted. Works in place on the decoded channel data, with no full-length scratch buffers.
+ */
+
+export const LOUDNESS_TARGET_LUFS = -16;
+/** Sample-peak ceiling after levelling, in dBFS (leaves room for the Opus encoder's overshoot). */
+export const PEAK_CEILING_DBFS = -1.5;
+/** Never boost more than this, so near-silent recordings don't turn into loud hiss. */
+export const MAX_GAIN_DB = 18;
+
+const ABSOLUTE_GATE_LUFS = -70;
+const RELATIVE_GATE_LU = -10;
+const LOOKAHEAD_MS = 5;
+const RELEASE_MS = 120;
+
+interface Biquad {
+    b0: number;
+    b1: number;
+    b2: number;
+    a1: number;
+    a2: number;
+}
+
+/** BS.1770 K-weighting (high-shelf pre-filter + RLB high-pass) for any sample rate. */
+export const kWeightingFilters = (sampleRate: number): [Biquad, Biquad] => {
+    let f0 = 1681.974450955533;
+    const G = 3.999843853973347;
+    let Q = 0.7071752369554196;
+    let K = Math.tan((Math.PI * f0) / sampleRate);
+    const Vh = Math.pow(10, G / 20);
+    const Vb = Math.pow(Vh, 0.4996667741545416);
+    let a0 = 1 + K / Q + K * K;
+    const shelf: Biquad = {
+        b0: (Vh + (Vb * K) / Q + K * K) / a0,
+        b1: (2 * (K * K - Vh)) / a0,
+        b2: (Vh - (Vb * K) / Q + K * K) / a0,
+        a1: (2 * (K * K - 1)) / a0,
+        a2: (1 - K / Q + K * K) / a0,
+    };
+
+    f0 = 38.13547087602444;
+    Q = 0.5003270373238773;
+    K = Math.tan((Math.PI * f0) / sampleRate);
+    a0 = 1 + K / Q + K * K;
+    const highpass: Biquad = {
+        b0: 1,
+        b1: -2,
+        b2: 1,
+        a1: (2 * (K * K - 1)) / a0,
+        a2: (1 - K / Q + K * K) / a0,
+    };
+    return [shelf, highpass];
+};
+
+/**
+ * Integrated loudness in LUFS of the signal made of `channels` (each weighted 1.0, as for L/R).
+ * Pass the same array twice for mono that will be played as stereo. Returns -Infinity for silence.
+ */
+export const measureLoudness = (channels: Float32Array[], sampleRate: number): number => {
+    const frames = channels[0]?.length ?? 0;
+    if (frames === 0) return -Infinity;
+    const step = Math.round(sampleRate * 0.1); // 100 ms; a block is 4 steps (400 ms)
+    const steps = Math.floor(frames / step);
+    // Clips shorter than one block are measured as a whole (plain mean square), so they're levelled too
+    const bucket = steps >= 4 ? step : frames;
+
+    // Sum of K-weighted squares per 100 ms step, over all channels (a trailing partial step is dropped)
+    const stepEnergy = new Float64Array(Math.max(steps, 1));
+    const [s, h] = kWeightingFilters(sampleRate);
+    for (const data of channels) {
+        let x1 = 0,
+            x2 = 0,
+            y1 = 0,
+            y2 = 0; // shelf state
+        let u1 = 0,
+            u2 = 0,
+            z1 = 0,
+            z2 = 0; // high-pass state
+        let k = 0;
+        let filled = 0;
+        let acc = 0;
+        for (let i = 0; i < frames; i++) {
+            const x = data[i];
+            const y = s.b0 * x + s.b1 * x1 + s.b2 * x2 - s.a1 * y1 - s.a2 * y2;
+            x2 = x1;
+            x1 = x;
+            y2 = y1;
+            y1 = y;
+            const z = h.b0 * y + h.b1 * u1 + h.b2 * u2 - h.a1 * z1 - h.a2 * z2;
+            u2 = u1;
+            u1 = y;
+            z2 = z1;
+            z1 = z;
+            acc += z * z;
+            if (++filled === bucket) {
+                if (k < stepEnergy.length) stepEnergy[k] += acc;
+                k++;
+                filled = 0;
+                acc = 0;
+            }
+        }
+    }
+
+    const toLufs = (meanSquare: number) => -0.691 + 10 * Math.log10(meanSquare);
+
+    if (steps < 4) {
+        const ms = stepEnergy[0] / frames;
+        return ms > 0 ? toLufs(ms) : -Infinity;
+    }
+
+    // 400 ms blocks, hopping 100 ms
+    const blocks = new Float64Array(steps - 3);
+    for (let b = 0; b < blocks.length; b++) {
+        blocks[b] =
+            (stepEnergy[b] + stepEnergy[b + 1] + stepEnergy[b + 2] + stepEnergy[b + 3]) /
+            (4 * step);
+    }
+
+    const absGate = Math.pow(10, (ABSOLUTE_GATE_LUFS + 0.691) / 10);
+    let sum = 0;
+    let count = 0;
+    for (const z of blocks) {
+        if (z > absGate) {
+            sum += z;
+            count++;
+        }
+    }
+    if (count === 0) return -Infinity;
+
+    const relGate = (sum / count) * Math.pow(10, RELATIVE_GATE_LU / 10);
+    const gate = Math.max(absGate, relGate);
+    sum = 0;
+    count = 0;
+    for (const z of blocks) {
+        if (z > gate) {
+            sum += z;
+            count++;
+        }
+    }
+    return count ? toLufs(sum / count) : -Infinity;
+};
+
+/**
+ * Multiplies `channels` in place by `gain`, limiting peaks to `ceiling` (linear) with a smooth
+ * look-ahead gain envelope shared by all channels (so the stereo image doesn't shift).
+ *
+ * Envelope: the needed gain per frame is peak-held over the look-ahead window, given a slow
+ * release, then averaged over the same window. Every frame of the average only sees values at or
+ * below the needed gain of the frame it protects, so no sample ends up above the ceiling.
+ */
+export const applyGainWithLimiter = (
+    channels: Float32Array[],
+    sampleRate: number,
+    gain: number,
+    ceiling: number,
+) => {
+    const unique = Array.from(new Set(channels));
+    const frames = unique[0]?.length ?? 0;
+    const la = Math.max(1, Math.round((sampleRate * LOOKAHEAD_MS) / 1000));
+    const release = 1 - Math.exp(-1 / ((sampleRate * RELEASE_MS) / 1000));
+
+    const needed = (i: number) => {
+        let peak = 0;
+        for (const c of unique) {
+            const v = Math.abs(c[i]);
+            if (v > peak) peak = v;
+        }
+        const p = peak * gain;
+        return p > ceiling ? ceiling / p : 1;
+    };
+
+    // Sliding minimum of needed() over [i, i + la - 1] (monotonic deque, indexes into a ring)
+    const dqIdx = new Int32Array(la + 1);
+    const dqVal = new Float64Array(la + 1);
+    let head = 0;
+    let size = 0;
+    const cap = la + 1;
+    const push = (idx: number, val: number) => {
+        while (size > 0 && dqVal[(head + size - 1) % cap] >= val) size--;
+        const pos = (head + size) % cap;
+        dqIdx[pos] = idx;
+        dqVal[pos] = val;
+        size++;
+    };
+    let next = 0; // next frame index to push into the window
+    const fill = (upTo: number) => {
+        for (; next <= upTo && next < frames; next++) push(next, needed(next));
+    };
+
+    // Moving average of the held/released envelope over the last `la` frames. It starts out holding
+    // the first window's minimum, so a peak right at the start is covered like any other.
+    fill(la - 1);
+    const first = size > 0 ? dqVal[head] : 1;
+    const ring = new Float64Array(la).fill(first);
+    let ringSum = first * la;
+    let ringPos = 0;
+    let released = first;
+
+    for (let i = 0; i < frames; i++) {
+        fill(i + la - 1);
+        while (size > 0 && dqIdx[head] < i) {
+            head = (head + 1) % cap;
+            size--;
+        }
+        const held = size > 0 ? dqVal[head] : 1;
+
+        released = Math.min(held, released + (1 - released) * release);
+
+        ringSum += released - ring[ringPos];
+        ring[ringPos] = released;
+        ringPos = (ringPos + 1) % la;
+        const env = ringSum / la;
+
+        const g = gain * env;
+        for (const c of unique) c[i] *= g;
+    }
+};
+
+/** Linear sample peak across channels. */
+const samplePeak = (channels: Float32Array[]) => {
+    let peak = 0;
+    for (const c of new Set(channels)) {
+        for (let i = 0; i < c.length; i++) {
+            const v = Math.abs(c[i]);
+            if (v > peak) peak = v;
+        }
+    }
+    return peak;
+};
+
+export interface LevelResult {
+    /** Loudness before levelling, LUFS (-Infinity for silence). */
+    measured: number;
+    /** Gain applied, dB (0 when nothing was done). */
+    gainDb: number;
+    /** Whether the peak limiter had to step in. */
+    limited: boolean;
+}
+
+/**
+ * Levels decoded audio in place to LOUDNESS_TARGET_LUFS.
+ * `channels` are the channels that will be encoded (the same array twice for mono → stereo).
+ */
+export const levelLoudness = (channels: Float32Array[], sampleRate: number): LevelResult => {
+    const measured = measureLoudness(channels, sampleRate);
+    if (!isFinite(measured)) return { measured, gainDb: 0, limited: false };
+
+    const ceiling = Math.pow(10, PEAK_CEILING_DBFS / 20);
+    let current = measured;
+    let gainDb = 0;
+    let limited = false;
+
+    // Limiting takes some loudness back off, so re-measure and top up (a few passes at most).
+    for (let pass = 0; pass < 3; pass++) {
+        const step = Math.min(LOUDNESS_TARGET_LUFS - current, MAX_GAIN_DB - gainDb);
+        if (Math.abs(step) < 0.1) break;
+
+        const gain = Math.pow(10, step / 20);
+        gainDb += step;
+        if (samplePeak(channels) * gain > ceiling) {
+            applyGainWithLimiter(channels, sampleRate, gain, ceiling);
+            limited = true;
+        } else {
+            for (const c of new Set(channels)) {
+                for (let i = 0; i < c.length; i++) c[i] *= gain;
+            }
+            break; // a plain gain lands exactly on target
+        }
+
+        current = measureLoudness(channels, sampleRate);
+        if (LOUDNESS_TARGET_LUFS - current < 0.5) break;
+    }
+    return { measured, gainDb, limited };
+};
