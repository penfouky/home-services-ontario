+import React, { useState } from "react";
+import { useTranslation } from "react-i18next";
+import { useNavigate } from "react-router-dom";
+import styled from "styled-components";
+import { Button, Result, Spin, theme } from "antd";
+import { CheckCircleFilled, PlusOutlined } from "@ant-design/icons";
+
+import { TeddyCloudApi } from "../../../api";
+import { defaultAPIConfig } from "../../../config/defaultApiConfig";
+import { useTonies } from "../../../hooks/useTonies";
+import { useTeddyCloud } from "../../../provider/TeddyCloudProvider";
+import { NotificationTypeEnum } from "../../../types/teddyCloudNotificationTypes";
+import { TonieCardProps } from "../../../types/tonieTypes";
+import { AddedAudio } from "./hooks/useEncoder";
+
+const api = new TeddyCloudApi(defaultAPIConfig());
+const { useToken } = theme;
+
+const Panel = styled.div<{ $bg: string; $border: string }>`
+    background: ${({ $bg }) => $bg};
+    border: 1px solid ${({ $border }) => $border};
+    border-radius: 18px;
+    padding: 18px 16px;
+    margin-bottom: 16px;
+`;
+
+const Heading = styled.div`
+    display: flex;
+    gap: 12px;
+    align-items: flex-start;
+    margin-bottom: 14px;
+
+    h3 {
+        margin: 0 0 2px;
+    }
+    p {
+        margin: 0;
+    }
+`;
+
+const Grid = styled.div`
+    display: grid;
+    grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
+    gap: 10px;
+    margin-bottom: 16px;
+`;
+
+const Tile = styled.button<{
+    $selected: boolean;
+    $accent: string;
+    $bg: string;
+    $border: string;
+    $color: string;
+}>`
+    all: unset;
+    box-sizing: border-box;
+    cursor: pointer;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 6px;
+    min-height: 44px;
+    padding: 10px 8px;
+    border-radius: 16px;
+    background: ${({ $bg }) => $bg};
+    color: ${({ $color }) => $color};
+    border: 2px solid ${({ $selected, $accent, $border }) => ($selected ? $accent : $border)};
+    box-shadow: ${({ $selected, $accent }) => ($selected ? `0 0 0 3px ${$accent}33` : "none")};
+    text-align: center;
+    font-size: 13px;
+    font-weight: 700;
+    line-height: 1.25;
+    word-break: break-word;
+    -webkit-tap-highlight-color: transparent;
+
+    img {
+        width: 72px;
+        height: 72px;
+        object-fit: contain;
+    }
+    &:focus-visible {
+        outline: 2px solid ${({ $accent }) => $accent};
+        outline-offset: 2px;
+    }
+`;
+
+const Actions = styled.div`
+    display: flex;
+    flex-wrap: wrap;
+    gap: 10px;
+
+    .ant-btn {
+        flex: 1 1 220px;
+    }
+`;
+
+const Small = styled.span<{ $color: string }>`
+    font-size: 12px;
+    font-weight: 600;
+    color: ${({ $color }) => $color};
+`;
+
+/** "lib://Stories/Bedtime.taf" -> "Bedtime" */
+const fileTitle = (source: string) =>
+    (source.split("/").pop() || source).replace(/\.(taf|tap)$/i, "");
+
+const tonieTitle = (tonie: TonieCardProps, fallback: string) =>
+    tonie.tonieInfo?.series
+        ? tonie.tonieInfo.series + (tonie.tonieInfo.episode ? ` – ${tonie.tonieInfo.episode}` : "")
+        : fallback;
+
+/**
+ * Shown after audio was added: pick the tonie that should play it, in one tap.
+ * Sets the tonie's source to the new file and makes sure it plays from this server.
+ */
+export const AssignToTonie: React.FC<{ added: AddedAudio; onAddMore: () => void }> = ({
+    added,
+    onAddMore,
+}) => {
+    const { t } = useTranslation();
+    const { token } = useToken();
+    const navigate = useNavigate();
+    const { addNotification } = useTeddyCloud();
+    const { tonies, loading } = useTonies({ merged: false, filter: "tag" });
+
+    const [selected, setSelected] = useState<TonieCardProps | null>(null);
+    const [saving, setSaving] = useState(false);
+    const [doneFor, setDoneFor] = useState<string | null>(null);
+
+    const unknown = t("tonies.unsetTonie");
+
+    const assign = async () => {
+        if (!selected) return;
+        setSaving(true);
+        try {
+            await api.apiPostTeddyCloudContentJson(
+                selected.ruid,
+                "source=" + encodeURIComponent(added.source),
+                "",
+            );
+            // play from this server, not the cloud
+            if (!selected.nocloud)
+                await api.apiPostTeddyCloudContentJson(selected.ruid, "nocloud=true", "");
+            if (selected.live)
+                await api.apiPostTeddyCloudContentJson(selected.ruid, "live=false", "");
+            setDoneFor(tonieTitle(selected, unknown));
+        } catch (error) {
+            addNotification(
+                NotificationTypeEnum.Error,
+                t("crewcloud.encoder.assignFailed", "Couldn't give the audio to that tonie"),
+                String(error ?? ""),
+                t("tonies.title"),
+            );
+        } finally {
+            setSaving(false);
+        }
+    };
+
+    if (doneFor) {
+        return (
+            <Panel
+                $bg={token.colorBgContainer}
+                $border={token.colorBorderSecondary}
+                data-testid="assign-done"
+            >
+                <Result
+                    status="success"
+                    style={{ padding: "12px 0" }}
+                    title={t("crewcloud.encoder.assignedTitle", "All set!")}
+                    subTitle={t(
+                        "crewcloud.encoder.assignedText",
+                        'Put {{tonie}} on the box to hear "{{name}}".',
+                        { tonie: doneFor, name: added.name },
+                    )}
+                    extra={
+                        <Actions>
+                            <Button
+                                type="primary"
+                                size="large"
+                                icon={<PlusOutlined />}
+                                onClick={onAddMore}
+                            >
+                                {t("crewcloud.encoder.addMore", "Add more audio")}
+                            </Button>
+                            <Button size="large" onClick={() => navigate("/tonies")}>
+                                {t("crewcloud.setup.tonie.cta", "See my tonies")}
+                            </Button>
+                        </Actions>
+                    }
+                />
+            </Panel>
+        );
+    }
+
+    return (
+        <Panel
+            $bg={token.colorBgContainer}
+            $border={token.colorBorderSecondary}
+            data-testid="assign-to-tonie"
+        >
+            <Heading>
+                <CheckCircleFilled
+                    style={{ color: token.colorSuccess, fontSize: 28, marginTop: 2 }}
+                />
+                <div>
+                    <h3>{t("crewcloud.encoder.doneTitle", "Added to your library")}</h3>
+                    <p style={{ color: token.colorTextSecondary }}>
+                        {t(
+                            "crewcloud.encoder.doneText",
+                            '"{{name}}" is ready. Which tonie should play it?',
+                            { name: added.name },
+                        )}
+                    </p>
+                </div>
+            </Heading>
+
+            {loading ? (
+                <div style={{ textAlign: "center", padding: 24 }}>
+                    <Spin />
+                </div>
+            ) : tonies.length === 0 ? (
+                <p style={{ color: token.colorTextSecondary }}>
+                    {t(
+                        "crewcloud.encoder.noTonies",
+                        "No tonies yet. Put a tonie on your box once, then come back to give it this audio.",
+                    )}
+                </p>
+            ) : (
+                <Grid
+                    role="radiogroup"
+                    aria-label={t("crewcloud.encoder.pickTonie", "Choose a tonie")}
+                >
+                    {tonies.map((tonie) => {
+                        const title = tonieTitle(tonie, unknown);
+                        const picture = tonie.tonieInfo?.picture?.trim()
+                            ? tonie.tonieInfo.picture
+                            : "/img_unknown.png";
+                        const isSelected = selected?.ruid === tonie.ruid;
+                        return (
+                            <Tile
+                                key={tonie.ruid}
+                                type="button"
+                                role="radio"
+                                aria-checked={isSelected}
+                                onClick={() => setSelected(tonie)}
+                                $selected={isSelected}
+                                $accent={token.colorPrimary}
+                                $bg={isSelected ? token.colorPrimaryBg : token.colorFillQuaternary}
+                                $border={token.colorBorderSecondary}
+                                $color={token.colorText}
+                            >
+                                <img src={picture} alt="" loading="lazy" />
+                                <span>{title}</span>
+                                {/* tell look-alike tags apart, and show what a tonie plays now */}
+                                {!tonie.tonieInfo?.series && tonie.uid ? (
+                                    <Small $color={token.colorTextSecondary}>
+                                        {tonie.uid.slice(0, 11)}
+                                    </Small>
+                                ) : null}
+                                {tonie.source?.startsWith("lib://") ? (
+                                    <Small $color={token.colorTextSecondary}>
+                                        {t("crewcloud.encoder.nowPlays", "Now: {{name}}", {
+                                            name: fileTitle(tonie.source),
+                                        })}
+                                    </Small>
+                                ) : null}
+                            </Tile>
+                        );
+                    })}
+                </Grid>
+            )}
+
+            <Actions>
+                {tonies.length > 0 && (
+                    <Button
+                        type="primary"
+                        size="large"
+                        disabled={!selected}
+                        loading={saving}
+                        onClick={assign}
+                        data-testid="assign-button"
+                    >
+                        {selected
+                            ? t("crewcloud.encoder.giveTo", "Give it to {{tonie}}", {
+                                  tonie: tonieTitle(selected, unknown),
+                              })
+                            : t("crewcloud.encoder.pickTonie", "Choose a tonie")}
+                    </Button>
+                )}
+                <Button size="large" onClick={onAddMore}>
+                    {t("crewcloud.encoder.later", "Not now")}
+                </Button>
+            </Actions>
+        </Panel>
+    );
+};
