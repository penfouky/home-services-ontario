index 113e5ad..aa188b9 100644
--- a/wasm/taf_encoder_minimal.c
+++ b/wasm/taf_encoder_minimal.c
@@ -72,6 +72,13 @@ typedef struct {
     
     // Bitrate
     int bitrate;
+
+    // Even-split page planning (Crew's Tonie Cloud fix): every 4 KB block is shared
+    // equally among the frames that fit in it, instead of giving the last frame only
+    // the leftover space (which starved one frame per block of ~40% of its bits).
+    int plan_block;   // taf_block_num the current plan was made for (-1 = none yet)
+    int plan_total;   // frames planned to fill this block
+    int plan_used;    // frames already emitted into this block
 } taf_encoder_t;
 
 // Forward declaration (defined at end of file) so error paths in
@@ -180,6 +187,9 @@ taf_encoder_t *taf_encoder_create(uint32_t audio_id, int bitrate) {
     ctx->taf.sha1_hash.data = NULL;  // Will be allocated in finalize
     ctx->taf.sha1_hash.len = 0;
     
+    // No block planned yet (block 0 is valid, so -1 is the sentinel)
+    ctx->plan_block = -1;
+
     // Initialize SHA1
     sha1Init(&ctx->sha1);
     
@@ -360,19 +370,48 @@ int taf_encoder_encode(taf_encoder_t *ctx, int16_t *samples, int num_samples) {
                 }
             }
             
+            /* Even-split page planning: plan the block on its first frame so every frame
+               gets an equal share of the 4 KB, then cap this frame to its share. The last
+               planned frame is padded to fill the block, so alignment and file size are
+               unchanged; only the quality distribution within the block improves. */
+            bool fill_block = false;
+            {
+                if ((int)ctx->taf_block_num != ctx->plan_block) {
+                    int nat = ctx->bitrate * 1000 / 8 * 60 / 1000;   /* target bytes per 60 ms frame */
+                    int per = nat + nat / 255 + 1;                    /* + its Ogg lacing bytes */
+                    if (per < OPUS_PACKET_MINSIZE + 2) per = OPUS_PACKET_MINSIZE + 2;
+                    ctx->plan_block = (int)ctx->taf_block_num;
+                    ctx->plan_used = 0;
+                    ctx->plan_total = page_remain / per;
+                    if (page_remain - ctx->plan_total * per >= OPUS_PACKET_MINSIZE + 2) ctx->plan_total++;
+                    if (ctx->plan_total < 1) ctx->plan_total = 1;
+                }
+                int left = ctx->plan_total - ctx->plan_used;
+                if (left <= 1) {
+                    fill_block = true;                               /* last planned frame fills the block */
+                } else {
+                    int share = page_remain / left;
+                    int pay = share - (share / 256 + 1);
+                    int rest = page_remain - (pay + pay / 255 + 1);
+                    if (rest % 256 == 0) pay--;                      /* keep the remainder exactly fillable */
+                    if (pay >= OPUS_PACKET_MINSIZE - 1 && pay < frame_payload) frame_payload = pay;
+                }
+                ctx->plan_used++;
+            }
+
             // Encode Opus frame
             //printf("taf_encoder_encode: Encoding frame...\n");
             unsigned char output_frame[TONIEFILE_FRAME_SIZE];
             //printf("taf_encoder_encode: Calling opus_encode (payload=%d)\n", frame_payload);
             int frame_len = opus_encode(ctx->enc, ctx->audio_frame, OPUS_FRAME_SIZE,
                                        output_frame, frame_payload);
-            
+
             if (frame_len <= 0) {
                 return -1;
             }
-            
+
             /* we did not exactly hit the destination size and are close to block size. pad packet */
-            if (frame_payload - frame_len < OPUS_PACKET_PAD) {
+            if (fill_block || frame_payload - frame_len < OPUS_PACKET_PAD) {
                 int target_length = frame_payload;
                 int ret = opus_packet_pad(output_frame, frame_len, target_length);
                 if (ret < 0) {
@@ -425,7 +464,67 @@ int taf_encoder_new_chapter(taf_encoder_t *ctx) {
     if (!ctx || ctx->taf.n_track_page_nums >= TONIEFILE_MAX_CHAPTERS - 1) {
         return -1;
     }
-    
+
+    /* Start every chapter on a fresh 4 KB block (Crew's Tonie Cloud fix). Upstream marks
+       the chapter at the current block, which still holds the tail of the previous track,
+       so skipping to a chapter first replays up to ~180 ms of the one before it. Here we
+       finish the partial frame and pad the block with silence, so the mark lands on a clean
+       block boundary and a jump starts exactly at the chapter. Cost: <=~60 ms of silence. */
+    int16_t silence[OPUS_FRAME_SIZE * OPUS_CHANNELS];
+    memset(silence, 0, sizeof(silence));
+
+    /* 1. two chapters must never share an Opus frame: finish the partial frame */
+    if (ctx->audio_frame_used > 0) {
+        if (taf_encoder_encode(ctx, silence, OPUS_FRAME_SIZE - ctx->audio_frame_used) != 0) {
+            return -1;
+        }
+    }
+
+    /* 2. fill the rest of the current block with silence packet(s), sized to land exactly
+       on the block boundary (a whole packet that fits, else a minimal one, then re-check) */
+    for (int guard = 0; guard < 8; guard++) {
+        int page_used = (ctx->output_size % TONIEFILE_FRAME_SIZE) + OGG_HEADER_LENGTH +
+                        ctx->os.lacing_fill - ctx->os.lacing_returned +
+                        ctx->os.body_fill - ctx->os.body_returned;
+        int page_remain = TONIEFILE_FRAME_SIZE - page_used;
+        if ((ctx->os.body_fill - ctx->os.body_returned) <= 0 || page_remain <= 0) {
+            break;  /* nothing buffered / already at a boundary */
+        }
+        int payload = (page_remain / 256) * 255 + (page_remain % 256) - 1;
+        int exact = ((payload / 255) + 1 + payload) == page_remain;
+        if (!exact) {
+            payload = OPUS_PACKET_MINSIZE;  /* leave an exactly fillable remainder for the next pass */
+        }
+        unsigned char pkt[TONIEFILE_FRAME_SIZE];
+        int len = opus_encode(ctx->enc, silence, OPUS_FRAME_SIZE, pkt, payload);
+        if (len <= 0 || opus_packet_pad(pkt, len, payload) < 0) {
+            return -1;
+        }
+        ctx->ogg_granule_position += OPUS_FRAME_SIZE;
+        ogg_packet op;
+        op.packet = pkt;
+        op.bytes = payload;
+        op.b_o_s = 0;
+        op.e_o_s = 0;
+        op.granulepos = ctx->ogg_granule_position;
+        op.packetno = ctx->ogg_packet_count++;
+        ogg_stream_packetin(&ctx->os, &op);
+        if (exact) {
+            break;
+        }
+    }
+
+    /* 3. flush the completed block(s) so the new chapter begins on a fresh block */
+    ogg_page og;
+    while (ogg_stream_flush(&ctx->os, &og)) {
+        if (buffer_write(ctx, og.header, og.header_len) != 0 ||
+            buffer_write(ctx, og.body, og.body_len) != 0) {
+            return -1;
+        }
+        ctx->taf_block_num++;
+    }
+    ctx->plan_block = -1;  /* force a fresh block plan for the new chapter */
+
     ctx->taf.track_page_nums[ctx->taf.n_track_page_nums++] = ctx->taf_block_num;
     return 0;
 }
