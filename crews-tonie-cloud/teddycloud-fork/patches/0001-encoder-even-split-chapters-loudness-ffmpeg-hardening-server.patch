+#if defined(FFMPEG_DECODING) && !defined(_WIN32)
+/* Crew's Tonie Cloud: run ffmpeg without a shell.
+ *
+ * Upstream builds a command string and hands it to popen(), which runs it through /bin/sh.
+ * A source path containing a quote or a shell metacharacter would then break the command or
+ * inject into it. Here ffmpeg is fork/exec'd directly with an argument vector, so the path is
+ * passed verbatim and never interpreted. The child pid is tracked so _end() can reap it. */
+#include <unistd.h>
+#include <fcntl.h>
+#include <sys/wait.h>
+#include <pthread.h>
+#include <errno.h>
+
+#define FFMPEG_MAX_PIPES 64
+static struct
+{
+    int fd;
+    pid_t pid;
+} ffmpeg_pids[FFMPEG_MAX_PIPES];
+static pthread_mutex_t ffmpeg_pids_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void ffmpeg_pid_store(int fd, pid_t pid)
+{
+    pthread_mutex_lock(&ffmpeg_pids_lock);
+    for (int i = 0; i < FFMPEG_MAX_PIPES; i++)
+    {
+        if (ffmpeg_pids[i].pid == 0)
+        {
+            ffmpeg_pids[i].fd = fd;
+            ffmpeg_pids[i].pid = pid;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&ffmpeg_pids_lock);
+}
+
+static pid_t ffmpeg_pid_take(int fd)
+{
+    pid_t pid = 0;
+    pthread_mutex_lock(&ffmpeg_pids_lock);
+    for (int i = 0; i < FFMPEG_MAX_PIPES; i++)
+    {
+        if (ffmpeg_pids[i].pid != 0 && ffmpeg_pids[i].fd == fd)
+        {
+            pid = ffmpeg_pids[i].pid;
+            ffmpeg_pids[i].pid = 0;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&ffmpeg_pids_lock);
+    return pid;
+}
+
+/* fork/exec ffmpeg with argv (no shell). If in_fd >= 0 it becomes ffmpeg's stdin (used for the
+   byte-skip path). Returns a FILE* reading ffmpeg's stdout, or NULL. Between fork and exec only
+   async-signal-safe calls are used, which is required in this multithreaded server. */
+static FILE *ffmpeg_spawn(char *const argv[], int in_fd)
+{
+    int pipefd[2];
+    if (pipe(pipefd) != 0)
+    {
+        if (in_fd >= 0)
+            close(in_fd);
+        return NULL;
+    }
+    pid_t pid = fork();
+    if (pid < 0)
+    {
+        close(pipefd[0]);
+        close(pipefd[1]);
+        if (in_fd >= 0)
+            close(in_fd);
+        return NULL;
+    }
+    if (pid == 0)
+    {
+        /* child: wire stdout (and optionally stdin), then exec */
+        dup2(pipefd[1], STDOUT_FILENO);
+        if (in_fd >= 0)
+            dup2(in_fd, STDIN_FILENO);
+        close(pipefd[0]);
+        close(pipefd[1]);
+        if (in_fd >= 0)
+            close(in_fd);
+        execvp("ffmpeg", argv);
+        _exit(127); /* exec failed */
+    }
+    /* parent */
+    close(pipefd[1]);
+    if (in_fd >= 0)
+        close(in_fd);
+    FILE *f = fdopen(pipefd[0], "r");
+    if (f == NULL)
+    {
+        close(pipefd[0]);
+        int status;
+        waitpid(pid, &status, 0);
+        return NULL;
+    }
+    ffmpeg_pid_store(fileno(f), pid);
+    return f;
+}
